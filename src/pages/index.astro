---
const destination = "/sitepulse/";
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0; url=/sitepulse/" />
    <link rel="canonical" href="https://zimo.no/sitepulse/" />
    <title>SitePulse - ZiMO</title>
    <script is:inline>
      window.location.replace("/sitepulse/");
    </script>
  </head>
  <body>
    <p>Du blir sendt videre til <a href={destination}>SitePulse</a>.</p>
  </body>
</html>
