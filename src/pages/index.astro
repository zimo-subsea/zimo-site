---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const customerBenefits = [
  {
    number: "01",
    tag: "DASHBOARD / STATUS",
    title: "Oversikt over byggeplassen",
    text: "Samle sensorer, soner, alarmer og utstyr i ett webbasert prosjektbilde for kontor og mobil.",
    details: ["Byggeplass og soner", "Sensorstatus", "Alarmoversikt"],
    color: "red",
    accent: "#d22828",
  },
  {
    number: "02",
    tag: "ALERTS / THRESHOLDS",
    title: "Varsler ved avvik",
    text: "Fang opp frost, fukt, temperaturfall, lekkasje eller bortfall av strøm før små avvik blir dyre problemer.",
    details: ["Egne grenseverdier", "Varsel ved avvik", "Oppfølging over tid"],
    color: "green",
    accent: "#79a878",
  },
  {
    number: "03",
    tag: "HISTORY / TRENDS",
    title: "Historikk som kan brukes",
    text: "Gjør målinger om til erfaring: se utvikling, dokumenter forhold og sammenlign tiltak mellom prosjekter.",
    details: ["Trender og grafer", "Eksport ved behov", "Læring til neste prosjekt"],
    color: "amber",
    accent: "#d7a84a",
  },
  {
    number: "04",
    tag: "RULES / AUTOMATION",
    title: "Enkel automasjon",
    text: "Start med varsling, og legg til regelbaserte handlinger der det gir trygg og praktisk verdi.",
    details: ["Hvis dette, gjør dette", "Varme, vifter og pumper", "Manuell overstyring"],
    color: "red",
    accent: "#d22828",
  },
];

const useCases = [
  { label: "Byggvarme", text: "Reduser unødvendig energibruk med temperaturgrenser, varsler og enkel styring." },
  { label: "Støp og herding", text: "Følg temperaturforløp og forhold som påvirker fremdrift og kvalitet." },
  { label: "Uttørking", text: "Se luftfuktighet, temperatur og trender før neste arbeidsoperasjon." },
  { label: "Frostvarsling", text: "Varsle tidlig når vær og soneforhold nærmer seg kritiske grenser." },
  { label: "Vann og lekkasje", text: "Oppdag avvik tidlig og dokumenter hendelsesforløpet." },
  { label: "Energi og runtime", text: "Se driftstid, midlertidig forbruk og utstyr som står unødvendig på." },
];

const platformStack = [
  "Zigbee",
  "Matter / Thread",
  "LTE-M / NB-IoT",
  "GNSS",
  "Dashboard",
  "Varsler",
  "Historikk",
  "Automasjon",
];

const process = [
  { number: "01", command: "START", text: "Velg ett konkret problem der data kan endre en beslutning." },
  { number: "02", command: "MÅL", text: "Sett ut gateway og relevante sensorer i prosjektet." },
  { number: "03", command: "LÆR", text: "Bruk dashboard, varsler og historikk til å se mønster og avvik." },
  { number: "04", command: "UTVID", text: "Koble flere soner, sensorer og enkle automasjoner inn i samme plattform." },
];
---

<BaseLayout title="SitePulse - IoT for byggeplasser" description="SitePulse er en uavhengig IoT-plattform fra ZiMO for byggeplassovervåkning, varsler, historikk og enkel automasjon.">
  <Header />
  <main id="main-content" class="bg-[#191919] text-[#f5f5f7]">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="zimo-circuit-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
      <div class="absolute inset-y-0 right-0 hidden w-[45%] border-l border-white/10 lg:block" aria-hidden="true"></div>
      <div class="zimo-shell relative grid min-h-[620px] gap-10 py-16 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:py-20">
        <div class="max-w-3xl">
          <p class="zimo-eyebrow">SITEPULSE / BYGGEPLASS / IOT</p>
          <h1 class="mt-7 max-w-3xl text-5xl font-semibold leading-[1.03] sm:text-6xl lg:text-5xl xl:text-[4.25rem]">SitePulse for byggeplassen.<br /><span class="text-white/74">Måling, varsling og enkel automasjon.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/60">SitePulse hjelper entreprenører med å følge klima, energi, utstyr og avvik på byggeplassen. Start med ett konkret behov, og bygg gradvis videre på samme gateway, dashboard og datagrunnlag.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#plattform" class="inline-flex cursor-pointer items-center justify-center rounded-md bg-white px-6 py-3.5 text-sm font-semibold text-[#191919] transition-colors duration-200 hover:bg-[#dedede]">Se plattformen</a>
            <a href="#kontakt" class="inline-flex cursor-pointer items-center justify-center rounded-md border border-white/20 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white hover:bg-white/8">Snakk om pilot</a>
          </div>
        </div>

        <div class="relative overflow-hidden border border-white/14 bg-[#171717]/85 p-6 sm:p-8 lg:p-9">
          <div class="zimo-grid absolute inset-0 opacity-35" aria-hidden="true"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4 border-b border-white/12 pb-5">
              <p class="zimo-mono text-[11px] uppercase tracking-[0.12em] text-white/50">sitepulse.gateway / site-map</p>
              <span class="zimo-mono flex items-center gap-2 text-[10px] text-white/48"><span class="zimo-signal h-2 w-2 rounded-full bg-[#79a878]"></span>ONLINE</span>
            </div>
            <div class="zimo-mono mt-7 grid gap-4 text-sm leading-6 text-white/74">
              <div class="grid grid-cols-[2.25rem_1fr_auto] items-center gap-3"><span class="text-[#d22828]">01</span><span>SENSOR DATA</span><span class="h-2 w-2 rounded-full bg-[#d22828]"></span></div>
              <div class="grid grid-cols-[2.25rem_1fr_auto] items-center gap-3"><span class="text-[#79a878]">02</span><span>DASHBOARD + ALERTS</span><span class="h-2 w-2 rounded-full bg-[#79a878]"></span></div>
              <div class="grid grid-cols-[2.25rem_1fr_auto] items-center gap-3"><span class="text-[#d7a84a]">03</span><span>HISTORY + TRENDS</span><span class="h-2 w-2 rounded-full bg-[#d7a84a]"></span></div>
              <div class="grid grid-cols-[2.25rem_1fr_auto] items-center gap-3"><span class="text-[#d22828]">04</span><span>RULE BASED ACTIONS</span><span class="h-2 w-2 rounded-full bg-[#d22828]"></span></div>
            </div>
            <div class="mt-8 grid grid-cols-2 gap-px border border-white/12 bg-white/12 text-xs sm:grid-cols-4">
              <div class="bg-[#191919] p-3"><p class="zimo-mono text-[10px] text-white/38">NODE</p><p class="mt-2 font-medium text-white/80">GATEWAY</p></div>
              <div class="bg-[#191919] p-3"><p class="zimo-mono text-[10px] text-white/38">LINK</p><p class="mt-2 font-medium text-white/80">LTE-M</p></div>
              <div class="bg-[#191919] p-3"><p class="zimo-mono text-[10px] text-white/38">SITE</p><p class="mt-2 font-medium text-white/80">ZONES</p></div>
              <div class="bg-[#191919] p-3"><p class="zimo-mono text-[10px] text-white/38">STATUS</p><p class="mt-2 font-medium text-white/80">LIVE</p></div>
            </div>
            <div class="mt-7 flex items-center justify-between border-t border-white/12 pt-5 zimo-mono text-[11px] text-white/46"><span>STATUS: READY FOR PILOT</span><span class="text-[#79a878]">0x01</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="plattform" class="border-b border-white/10 bg-[#151515] py-20 lg:py-24">
      <div class="zimo-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
        <div><p class="zimo-eyebrow">Plattform / ett prosjektbilde</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.07] md:text-5xl">Fra manuelle kontroller til løpende oversikt.</h2></div>
        <div class="grid gap-px border border-white/12 bg-white/12 sm:grid-cols-2">
          <article class="bg-[#191919] p-7"><p class="zimo-mono text-[11px] text-[#79a878]">01 / SENSORER</p><h3 class="mt-5 text-xl font-semibold">Mål forholdene der arbeidet skjer</h3><p class="mt-3 text-sm leading-relaxed text-white/56">Temperatur, luftfuktighet, lekkasje, energi, runtime og andre relevante måledata kan kobles til samme prosjekt.</p></article>
          <article class="bg-[#191919] p-7"><p class="zimo-mono text-[11px] text-[#79a878]">02 / DASHBOARD</p><h3 class="mt-5 text-xl font-semibold">Se status på PC og mobil</h3><p class="mt-3 text-sm leading-relaxed text-white/56">Prosjektet får en felles oversikt over byggeplass, soner, sensorer, utstyr og åpne avvik.</p></article>
          <article class="bg-[#191919] p-7"><p class="zimo-mono text-[11px] text-[#d7a84a]">03 / DATA</p><h3 class="mt-5 text-xl font-semibold">Bruk historikken videre</h3><p class="mt-3 text-sm leading-relaxed text-white/56">Målingene kan gi bedre beslutninger i prosjektet nå, og bedre erfaringstall til neste prosjekt.</p></article>
          <article class="bg-[#191919] p-7"><p class="zimo-mono text-[11px] text-[#d22828]">04 / AUTOMASJON</p><h3 class="mt-5 text-xl font-semibold">Legg til regler når det er nyttig</h3><p class="mt-3 text-sm leading-relaxed text-white/56">For eksempel kan en ønsket minimumstemperatur gi varsel eller starte en avtalt handling når verdien faller under grensen.</p></article>
        </div>
      </div>
    </section>

    <section id="bruksomrader" class="relative overflow-hidden py-24 lg:py-32">
      <div class="zimo-circuit-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="zimo-shell relative">
        <div class="grid gap-10 border-b border-white/14 pb-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div><p class="zimo-eyebrow">Bruksområder / start enkelt</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.07] md:text-5xl">Begynn der data kan spare tid, energi eller feil.</h2></div>
          <p class="max-w-xl text-lg leading-relaxed text-white/56 lg:justify-self-end">SitePulse er ikke én temperatursensor. Det er en generell IoT- og automasjonsplattform der kunden kan starte med én enkel use case og koble mer av byggeplassen inn etter hvert.</p>
        </div>
        <div class="mt-12 grid gap-px border border-white/12 bg-white/12 md:grid-cols-3">
          {useCases.map((item, index) => <article class="min-h-[210px] bg-[#191919] p-7">
            <p class="zimo-mono text-[11px] text-white/44">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-8 text-xl font-semibold">{item.label}</h3>
            <p class="mt-4 text-sm leading-relaxed text-white/56">{item.text}</p>
          </article>)}
        </div>
      </div>
    </section>

    <section id="dashboard" class="border-b border-white/10 bg-[#202020] py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 border-b border-white/14 pb-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div><p class="zimo-eyebrow">Kunden får / 04 deler</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.07] md:text-5xl">Et praktisk dashboard for daglig oppfølging.</h2></div>
          <p class="max-w-xl text-lg leading-relaxed text-white/56 lg:justify-self-end">Målet er mindre synsing og mer målbar drift: se hva som skjer, finn avvik tidligere og gjør tiltak basert på faktiske forhold.</p>
        </div>
        <div class="mt-12 grid gap-px border border-white/12 bg-white/12 md:grid-cols-2">
          {customerBenefits.map((item) => <article class="group relative min-h-[280px] overflow-hidden bg-[#191919] p-7 sm:p-8">
            <div class={`zimo-trace zimo-trace-${item.color}`} aria-hidden="true"></div>
            <div class="relative flex h-full flex-col">
              <div class="flex items-start justify-between gap-4"><p class="zimo-mono text-[11px] text-white/44">{item.tag}</p><span class={`zimo-node zimo-node-${item.color}`}>{item.number}</span></div>
              <h3 class="mt-12 text-2xl font-semibold">{item.title}</h3>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-white/58">{item.text}</p>
              <ul class="zimo-mono mt-7 grid gap-1.5 text-[11px] text-white/46">{item.details.map((detail) => <li><span class="mr-2" style={`color: ${item.accent}`}>+</span>{detail}</li>)}</ul>
            </div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="gateway" class="border-y border-white/10 bg-[#151515] py-20 lg:py-24">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="zimo-eyebrow">Gateway / åpen utrulling</p>
          <h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.07] md:text-5xl">Én gateway kan samle mange byggeplassbehov.</h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/58">SitePulse Gateway er tenkt som en nettdrevet byggeplass-node som samler lokale sensordata og sender dem videre til plattformen. Den kan støtte både egne og kompatible tredjeparts sensorer der det gir lavere terskel og raskere utrulling.</p>
        </div>
        <div class="grid gap-px border border-white/12 bg-white/12 sm:grid-cols-2">
          {platformStack.map((platform) => <div class="bg-[#151515] p-6">
            <p class="zimo-mono text-[10px] uppercase tracking-[0.1em] text-white/38">SitePulse</p>
            <p class="mt-3 text-base font-medium text-white/84">{platform}</p>
          </div>)}
        </div>
      </div>
    </section>

    <section id="modell" class="border-y border-white/10 bg-[#202020] py-24 lg:py-32">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div><p class="zimo-eyebrow">Modell / plattformverdi</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.07] md:text-5xl">Gatewayen er inngangen. Plattformen er verdien.</h2></div>
          <p class="max-w-xl text-lg leading-relaxed text-white/56 lg:justify-self-end">SitePulse kan prises for rask utrulling: en lav terskel for gateway og abonnement, mens sensorer og ekstra utstyr velges etter prosjektets behov. Etter hvert ligger verdien i arbeidsflyten, dataene, automasjonene og historikken.</p>
        </div>
        <ol class="mt-14 grid gap-px border border-white/12 bg-white/12 lg:grid-cols-4">
          {process.map((step, index) => <li class="relative min-h-[230px] bg-[#202020] p-7"><p class="zimo-mono text-xs text-white/44">{step.number}</p><p class="zimo-mono mt-10 text-sm text-white/84">{step.command}</p><p class="mt-4 text-sm leading-relaxed text-white/56">{step.text}</p>{index < process.length - 1 && <span class="absolute right-0 top-1/2 hidden h-px w-3 bg-[#d22828] lg:block" aria-hidden="true"></span>}</li>)}
        </ol>
        <div class="zimo-mono mt-8 flex flex-wrap gap-x-7 gap-y-3 text-[11px] text-white/42"><span><span class="text-[#d22828]">[01]</span> PILOT MED ÉN USE CASE</span><span><span class="text-[#79a878]">[02]</span> SENSORER ETTER BEHOV</span><span><span class="text-[#d7a84a]">[03]</span> UTVID NÅR DET GIR VERDI</span></div>
      </div>
    </section>

    <section id="avgrensning" class="border-y border-white/10 bg-[#151515] py-20 lg:py-24">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="zimo-eyebrow">Uavhengighet / tydelige rammer</p>
          <h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.07] md:text-5xl">Byggeplassdata, ikke industrielle kjernesystemer.</h2>
        </div>
        <div class="space-y-5 text-base leading-relaxed text-white/58">
          <p>SitePulse utvikles som et selvstendig ZiMO-prosjekt, med egne ressurser, egne kontoer og offentlig tilgjengelig teknologi. Konfidensiell kunnskap, internt materiale og arbeidsgiverspesifikke løsninger brukes ikke.</p>
          <p>Plattformen retter seg mot generell byggeplassovervåkning, varsling, historikk og enkel lavrisiko automasjon. ZiMO tilbyr ikke utvikling av sikkerhetskritiske, maritime, offshore- eller industrielle elektriske systemer.</p>
          <p>Forespørsler vurderes før oppstart. Dersom et prosjekt kan gi interessekonflikt eller utydelig overlapp med andre arbeidsforhold, tas det ikke videre.</p>
        </div>
      </div>
    </section>

    <section id="kontakt" class="relative overflow-hidden bg-[#111111] py-24 lg:py-32">
      <div class="zimo-circuit-grid absolute inset-0 opacity-35" aria-hidden="true"></div>
      <div class="zimo-shell relative grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div><p class="zimo-eyebrow">Kontakt / pilot</p><h2 class="mt-5 max-w-2xl text-4xl font-semibold leading-[1.07] md:text-5xl">Har dere et byggeplassproblem som bør måles først?</h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-white/58">Start med ett konkret spørsmål: temperatur, fukt, energi, runtime, lekkasje eller status på en sone. Derfra kan SitePulse settes opp som en enkel pilot før løsningen utvides.</p><a href="mailto:mads.falk@zimo.no" class="mt-8 inline-flex cursor-pointer items-center justify-center rounded-md bg-white px-6 py-3.5 text-sm font-semibold text-[#191919] transition-colors duration-200 hover:bg-[#dedede]">Snakk om SitePulse</a></div>
        <div class="border border-white/14 bg-[#161616] p-2 sm:p-3"><div class="zimo-terminal-panel border border-white/10 bg-[#111111] p-5 sm:p-6"><div class="flex items-center justify-between border-b border-white/10 pb-4"><div class="flex items-center gap-3"><span class="flex gap-1" aria-hidden="true"><i class="h-1.5 w-1.5 rounded-full bg-[#d22828]"></i><i class="h-1.5 w-1.5 rounded-full bg-[#d7a84a]"></i><i class="h-1.5 w-1.5 rounded-full bg-[#79a878]"></i></span><p class="zimo-mono text-[10px] text-white/44">sitepulse@project:~/rules.c</p></div><span class="zimo-mono text-[10px] text-[#79a878]">SITE / LIVE</span></div><div class="relative mt-5"><pre class="zimo-terminal-output m-0 h-[22rem] overflow-hidden whitespace-pre-wrap break-words text-sm leading-7 text-white/72 sm:pr-14" aria-live="polite"><code data-zimo-terminal></code></pre><div class="zimo-code-minimap hidden sm:block" data-terminal-minimap aria-hidden="true"></div></div><div class="zimo-terminal-status mt-2 flex items-center justify-between gap-3 border-t border-white/10 pt-4" data-terminal-status data-state="waiting"><span class="flex items-center gap-2"><i class="zimo-terminal-status-dot" aria-hidden="true"></i><span class="zimo-mono text-[10px] text-white/46" data-terminal-status-text>AWAITING SITE DATA</span></span><span class="zimo-mono text-[10px] text-white/28">rules.c</span></div><a href="mailto:mads.falk@zimo.no" class="mt-5 inline-flex cursor-pointer items-center justify-center rounded-md border border-white/20 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white hover:bg-white/8">Send et pilotbehov</a><p class="zimo-mono mt-6 border-t border-white/10 pt-4 text-[10px] text-white/38">CREATED IN NORWAY / SITE DATA / PRACTICAL AUTOMATION</p></div></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const terminal = document.querySelector("[data-zimo-terminal]");
  const terminalStatus = document.querySelector("[data-terminal-status]");
  const terminalStatusText = document.querySelector("[data-terminal-status-text]");
  const terminalMinimap = document.querySelector("[data-terminal-minimap]");
  const examples = [
    [
      "#include <sitepulse.h>",
      "",
      "int main(void) {",
      "  watch(\"temperature\", zone_north);",
      "  alert_below(5.0);",
      "  log_trend(\"drying\", seven_days);",
      "  return 0;",
      "}",
    ],
    [
      "#include <sitepulse.h>",
      "",
      "int main(void) {",
      "  const bool site_is_cold = temp_c < min_temp;",
      "  if (site_is_cold) notify(\"check heating\");",
      "  return 0;",
      "}",
    ],
    [
      "#include <sitepulse.h>",
      "",
      "static void next_step(const char *need) { track(need); }",
      "int main(void) {",
      "  next_step(\"measure before scaling\");",
      "  return 0;",
      "}",
    ],
  ];
  const lines = examples[Math.floor(Math.random() * examples.length)];

  const escapeHtml = (value) => value.replace(/[&<>"']/g, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;",
  })[character]);
  const highlightLine = (line) => {
    const pattern = /("(?:\\.|[^"\\])*")|(#include)|(\b(?:int|void|bool|static|const|return|if|else)\b)|(\b(?:true|false)\b)|(\b(?:watch|alert_below|log_trend|notify|track|next_step)\b)|(\/\/.*$)/g;
    let cursor = 0;
    let html = "";
    for (const match of line.matchAll(pattern)) {
      html += escapeHtml(line.slice(cursor, match.index));
      const className = match[1] ? "string" : match[2] ? "preprocessor" : match[3] ? "keyword" : match[4] ? "literal" : match[5] ? "function" : "comment";
      html += `<span class="zimo-code-${className}">${escapeHtml(match[0])}</span>`;
      cursor = (match.index ?? 0) + match[0].length;
    }
    return html + escapeHtml(line.slice(cursor));
  };
  const highlightCode = (source, showCursor = true) => source.split("\n").map((line, index, allLines) => {
    const cursor = showCursor && index === allLines.length - 1 ? '<span class="zimo-code-cursor" aria-hidden="true"></span>' : "";
    return `<span class="zimo-code-line" data-line="${index + 1}">${highlightLine(line)}${cursor}</span>`;
  }).join("");
  const updateMinimap = (source) => {
    if (!terminalMinimap) return;
    const visibleLines = source.split("\n");
    terminalMinimap.innerHTML = lines.map((line, index) => {
      const visibleLength = visibleLines[index]?.length ?? 0;
      const width = line.length ? Math.round((visibleLength / line.length) * 100) : 0;
      const tone = line.startsWith("#") ? "amber" : line.includes("alert") || line.includes("notify") ? "red" : line.includes("return") ? "red" : "green";
      return `<i class="zimo-code-minimap-line zimo-code-minimap-${tone}${visibleLength ? " is-visible" : ""}" style="--minimap-width:${width}%"></i>`;
    }).join("");
  };
  const renderTerminal = (source, showCursor = true) => {
    if (terminal) terminal.innerHTML = highlightCode(source, showCursor);
    updateMinimap(source);
  };
  const setTerminalStatus = (state, label) => {
    if (terminalStatus) terminalStatus.dataset.state = state;
    if (terminalStatusText) terminalStatusText.textContent = label;
  };

  const writeTerminal = () => {
    if (!terminal || terminal.dataset.started) return;
    terminal.dataset.started = "true";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      renderTerminal(lines.join("\n"), false);
      setTerminalStatus("ready", "SITEPULSE READY");
      return;
    }
    setTerminalStatus("building", "READING SITE DATA");
    let line = 0;
    let character = 0;
    let source = "";
    const type = () => {
      if (!terminal) return;
      if (line >= lines.length) {
        renderTerminal(source, false);
        setTerminalStatus("ready", "SITEPULSE READY");
        return;
      }
      source += lines[line][character] ?? "";
      renderTerminal(source);
      character += 1;
      if (character > lines[line].length) {
        source += "\n";
        renderTerminal(source);
        line += 1;
        character = 0;
        window.setTimeout(type, 220);
        return;
      }
      window.setTimeout(type, 12);
    };
    type();
  };

  if (terminal) new IntersectionObserver((entries, observer) => {
    if (entries.some((entry) => entry.isIntersecting)) {
      writeTerminal();
      observer.disconnect();
    }
  }, { threshold: 0.35 }).observe(terminal);
</script>
