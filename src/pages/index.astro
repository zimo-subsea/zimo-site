---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const solutions = [
  { number: "01", title: "Varme bare når det trengs", text: "Styr byggvarme etter faktiske forhold, ikke etter antakelser eller en timer som ingen husker å endre.", label: "Byggvarme", accent: "yellow" },
  { number: "02", title: "Dokumentasjonen skriver seg selv", text: "Få historikk, målinger og hendelser samlet i en løpende logg som er klar når dere trenger den.", label: "Dokumentasjon", accent: "blue" },
  { number: "03", title: "Varsler før avvik blir kostnad", text: "Oppdag temperatur, fukt, frost og lekkasje tidlig nok til å gjøre noe med det.", label: "Varsling", accent: "red" },
];

const costDrivers = [
  { label: "Unødvendig byggvarme", status: "Reduseres med regler og tidsplaner", tone: "yellow" },
  { label: "Manuell oppfølging", status: "Samles i ett prosjektbilde", tone: "blue" },
  { label: "Avvik som oppdages for sent", status: "Varsles mens det fortsatt kan håndteres", tone: "red" },
  { label: "Utstyr som står ubrukt", status: "Flyttes videre mellom prosjekter", tone: "green" },
];

const flow = [
  { label: "Sensorer", text: "Måler forholdene der de faktisk skjer." },
  { label: "Gateway", text: "Kobler byggeplassen til løsningen." },
  { label: "SitePulse Cloud", text: "Samler status, historikk og regler." },
  { label: "Handling", text: "Varsler, dokumenterer eller styrer." },
];

const proofPoints = [
  { value: "01", label: "Én løsning", text: "for status, varsling, dokumentasjon og automasjon." },
  { value: "24/7", label: "Oversikt", text: "på kontoret, i felt eller på mobilen." },
  { value: "NOK", label: "Verdi", text: "gjort synlig i driftstid, energi og arbeid." },
];
---

<BaseLayout title="SitePulse - lavere kostnader på byggeplassen" description="SitePulse gir entreprenører bedre kontroll på byggeplassen gjennom automatisk overvåkning, dokumentasjon og styring.">
  <Header />

  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-[#111315] text-white">
      <div class="absolute inset-0 -z-10 zimo-pulse-grid opacity-70" aria-hidden="true"></div>
      <div class="absolute -right-32 top-24 -z-10 h-96 w-96 rounded-full bg-[#F4B400]/10 blur-3xl" aria-hidden="true"></div>
      <div class="zimo-shell grid min-h-[720px] items-center gap-14 py-20 lg:grid-cols-[0.88fr_1.12fr] lg:py-24">
        <div class="max-w-2xl">
          <p class="zimo-eyebrow text-[#F4B400]">SitePulse · kontroll på byggeplassen</p>
          <h1 class="mt-6 max-w-2xl text-5xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-[5.35rem]">Lavere kostnader på byggeplassen.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/68 sm:text-xl">Overvåk forholdene, dokumenter automatisk og styr utstyr etter faktisk behov. SitePulse gjør det enklere å se hvor kostnadene oppstår — og hva dere kan gjøre med dem.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#resultater" class="inline-flex cursor-pointer items-center justify-center rounded-[9px] bg-[#F4B400] px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:bg-[#ffd05a]">Se kostnadsbildet</a>
            <a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="inline-flex cursor-pointer items-center justify-center rounded-[9px] border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white/60 hover:bg-white/10">Åpne SitePulse Cloud</a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-4 border-t border-white/10 pt-5 text-sm text-white/55">
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#F4B400]"></span>Automatisk dokumentasjon</span>
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#F4B400]"></span>Varsling ved avvik</span>
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#F4B400]"></span>Styring etter behov</span>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-5 rounded-[20px] border border-[#F4B400]/15" aria-hidden="true"></div>
          <div class="relative rounded-[14px] border border-white/12 bg-[#1B1F23] p-3 shadow-[0_24px_80px_rgba(0,0,0,0.32)] sm:p-4">
            <div class="flex items-center justify-between border-b border-white/10 px-2 pb-4">
              <div class="flex items-center gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-[#F4B400] text-[#111315]">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true"><path d="M4 15c2.2 0 2.8-6 5-6s2.8 6 5 6 2.8-6 6-6" /></svg>
                </span>
                <div><p class="text-sm font-semibold">SitePulse Cloud</p><p class="mt-0.5 text-xs text-white/40">Bryggeparken · oversikt</p></div>
              </div>
              <span class="inline-flex items-center gap-2 rounded-full border border-[#9ACB70]/30 bg-[#9ACB70]/10 px-3 py-1.5 text-xs font-medium text-[#B7E596]"><span class="h-1.5 w-1.5 rounded-full bg-[#9ACB70]"></span>Alt i orden</span>
            </div>
            <div class="grid gap-3 pt-4 sm:grid-cols-3">
              <div class="rounded-[10px] border border-white/10 bg-white/[0.035] p-4"><p class="text-xs text-white/45">Estimert spart</p><p class="mt-3 text-2xl font-semibold tracking-[-0.04em]">18 420 kr</p><p class="mt-2 text-xs text-[#B7E596]">Demo-data</p></div>
              <div class="rounded-[10px] border border-white/10 bg-white/[0.035] p-4"><p class="text-xs text-white/45">Driftstid varme</p><p class="mt-3 text-2xl font-semibold tracking-[-0.04em]">−31 %</p><p class="mt-2 text-xs text-[#B7E596]">Denne uken</p></div>
              <div class="rounded-[10px] border border-white/10 bg-white/[0.035] p-4"><p class="text-xs text-white/45">Aktive regler</p><p class="mt-3 text-2xl font-semibold tracking-[-0.04em]">12</p><p class="mt-2 text-xs text-[#F4B400]">SitePulse status</p></div>
            </div>
            <div class="mt-3 rounded-[10px] border border-white/10 bg-white/[0.025] p-4 sm:p-5">
              <div class="flex items-start justify-between gap-4"><div><p class="text-sm font-semibold">Byggvarme · sone nord</p><p class="mt-1 text-xs text-white/40">Temperatur siste døgn</p></div><span class="rounded-full bg-[#F4B400]/12 px-2.5 py-1 text-xs font-medium text-[#F4B400]">Automatisk</span></div>
              <svg class="mt-6 h-36 w-full" viewBox="0 0 620 150" preserveAspectRatio="none" role="img" aria-label="Demo-graf som viser temperatur og oppvarming">
                <path d="M0 125H620M0 85H620M0 45H620" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
                <path d="M0 105C38 100 55 86 93 92S152 111 195 87S250 52 294 66S349 105 392 78S445 40 489 58S540 87 620 52" fill="none" stroke="#F4B400" stroke-width="3" vector-effect="non-scaling-stroke" />
                <path d="M0 128C52 129 79 127 116 130S183 125 222 128S280 129 320 126S391 128 428 126S507 128 620 126" fill="none" stroke="#9ACB70" stroke-width="2" stroke-dasharray="4 6" vector-effect="non-scaling-stroke" />
                <path class="zimo-pulse-line" d="M0 22H120L138 10L156 34L174 22H320L338 10L356 34L374 22H620" fill="none" stroke="rgba(244,180,0,0.45)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              </svg>
              <div class="mt-3 flex flex-wrap gap-4 text-xs text-white/45"><span class="flex items-center gap-2"><i class="h-1.5 w-5 bg-[#F4B400]"></i>Temperatur</span><span class="flex items-center gap-2"><i class="h-1.5 w-5 border-t border-dashed border-[#9ACB70]"></i>Grense</span><span class="flex items-center gap-2"><i class="h-1.5 w-5 border-t border-dashed border-[#F4B400]/50"></i>Signal</span></div>
            </div>
            <div class="mt-3 grid gap-3 sm:grid-cols-[1fr_auto]">
              <div class="rounded-[10px] border border-white/10 bg-white/[0.025] p-4"><div class="flex items-center justify-between"><p class="text-xs text-white/45">Siste hendelse</p><span class="text-xs text-white/35">10:42</span></div><p class="mt-3 text-sm font-medium">Regel aktiverte byggvarme</p><p class="mt-1 text-xs text-white/40">Temperatur under 5 °C · sone nord</p></div>
              <a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="inline-flex cursor-pointer items-center justify-center rounded-[10px] border border-[#F4B400]/40 px-5 py-3 text-sm font-semibold text-[#F4B400] transition-colors duration-200 hover:bg-[#F4B400] hover:text-[#111315]">Åpne Cloud <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-[#D9DDDA] bg-[#111315] text-white">
      <div class="zimo-shell grid gap-8 py-10 md:grid-cols-3">
        {proofPoints.map((point) => <div class="flex gap-4 border-t border-white/15 pt-4"><span class="text-sm font-semibold text-[#F4B400]">{point.value}</span><div><p class="text-sm font-semibold">{point.label}</p><p class="mt-1 max-w-xs text-sm leading-relaxed text-white/50">{point.text}</p></div></div>)}
      </div>
    </section>

    <section id="resultater" class="bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell grid gap-14 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
        <div>
          <p class="zimo-eyebrow">Kostnadsbildet</p>
          <h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Det koster å ikke vite.</h2>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-[#566267]">Unødvendig drift, manuell oppfølging og sene avvik blir fort usynlige kostnader. SitePulse gjør dem synlige, slik at dere kan prioritere riktig.</p>
          <a href="/#kontakt" class="mt-8 inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:text-[#8b6500]">Snakk om deres prosjekt <span class="text-[#F4B400]" aria-hidden="true">→</span></a>
        </div>
        <div class="overflow-hidden rounded-[14px] border border-[#D9DDDA] bg-white">
          <div class="flex items-center justify-between border-b border-[#E5E8E4] px-5 py-4 sm:px-7"><div><p class="text-sm font-semibold">Hvor kostnadene oppstår</p><p class="mt-1 text-xs text-[#768287]">SitePulse gjør oppfølgingen målbar</p></div><span class="rounded-full bg-[#F4B400]/15 px-3 py-1.5 text-xs font-semibold text-[#7A5900]">Demo</span></div>
          <div class="divide-y divide-[#E5E8E4]">
            {costDrivers.map((item) => <div class="grid gap-3 px-5 py-5 sm:grid-cols-[1fr_auto] sm:items-center sm:px-7"><div class="flex items-start gap-3"><span class:list={["mt-1.5 h-2 w-2 shrink-0 rounded-full", item.tone === "yellow" ? "bg-[#F4B400]" : item.tone === "blue" ? "bg-[#4CA6C8]" : item.tone === "red" ? "bg-[#D96B5A]" : "bg-[#7CAA59]"]}></span><p class="text-sm font-semibold">{item.label}</p></div><p class="text-sm text-[#68767A] sm:text-right">{item.status}</p></div>)}
          </div>
          <div class="border-t border-[#E5E8E4] bg-[#FBFCF9] px-5 py-5 sm:px-7"><div class="flex items-end justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#768287]">Demo-visning</p><p class="mt-2 text-3xl font-semibold tracking-[-0.05em] text-[#111315]">18 420 kr</p></div><p class="max-w-[10rem] text-right text-xs leading-relaxed text-[#68767A]">Eksempel på hvordan spart beløp kan vises når reelle data finnes.</p></div></div>
        </div>
      </div>
    </section>

    <section id="plattform" class="border-y border-[#D9DDDA] bg-white py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-end"><div><p class="zimo-eyebrow">Slik henger det sammen</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Én gateway. Kontroll i hvert ledd.</h2></div><p class="max-w-xl text-lg leading-relaxed text-[#566267] lg:justify-self-end">SitePulse kobler det fysiske på byggeplassen til en rolig, oversiktlig skyløsning. Dere starter med det dere trenger og bygger videre når nytten er synlig.</p></div>
        <div class="relative mt-16">
          <div class="absolute left-[10%] right-[10%] top-7 hidden border-t border-dashed border-[#F4B400] lg:block" aria-hidden="true"></div>
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {flow.map((item, index) => <div class="relative"><div class="flex items-center gap-4"><span class="relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-[12px] border border-[#F4B400]/45 bg-[#FFF9E7] text-sm font-semibold text-[#8B6500]"><span>{String(index + 1).padStart(2, "0")}</span></span><p class="text-lg font-semibold">{item.label}</p></div><p class="mt-5 max-w-[14rem] text-sm leading-relaxed text-[#68767A]">{item.text}</p></div>)}
          </div>
        </div>
        <div class="mt-16 grid gap-px overflow-hidden rounded-[14px] border border-[#D9DDDA] bg-[#D9DDDA] sm:grid-cols-3">
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">På byggeplassen</p><p class="mt-3 text-sm font-semibold">Sensorer og utstyr</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Mål temperatur, fukt og andre forhold der arbeidet skjer.</p></div>
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">Mellomrommet</p><p class="mt-3 text-sm font-semibold">SitePulse Gateway</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">En gateway holder byggeplassen koblet til Cloud.</p></div>
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">I Cloud</p><p class="mt-3 text-sm font-semibold">Status og handling</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Se historikk, få varsler og la regler gjøre oppfølgingen.</p></div>
        </div>
      </div>
    </section>

    <section id="losninger" class="bg-[#1B1F23] py-20 text-white lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-end"><div><p class="zimo-eyebrow text-[#F4B400]">Bygd rundt de dyre spørsmålene</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Store problemer. Enklere oppfølging.</h2></div><p class="max-w-xl text-lg leading-relaxed text-white/55 lg:justify-self-end">Start med ett konkret behov. SitePulse gjør det mulig å følge forholdene, dokumentere det som skjer og automatisere neste steg.</p></div>
        <div class="mt-16 divide-y divide-white/12 border-y border-white/12">
          {solutions.map((solution) => <article class="grid gap-6 py-9 lg:grid-cols-[4rem_0.75fr_1.25fr] lg:items-start"><span class:list={["text-sm font-semibold", solution.accent === "yellow" ? "text-[#F4B400]" : solution.accent === "blue" ? "text-[#69BBDD]" : "text-[#E98A78]"]}>{solution.number}</span><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-white/40">{solution.label}</p><h3 class="mt-3 max-w-md text-2xl font-semibold leading-tight tracking-[-0.025em]">{solution.title}</h3></div><p class="max-w-xl text-base leading-relaxed text-white/55 lg:pt-6">{solution.text}</p></article>)}
        </div>
      </div>
    </section>

    <section id="automasjon" class="bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell grid gap-14 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
        <div><p class="zimo-eyebrow">Automasjon</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Byggeplassen reagerer selv.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#566267]">Regler gjør at dere kan handle på målingene, ikke på magefølelsen. Hver handling er synlig, og kan overstyres manuelt.</p><a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="mt-8 inline-flex cursor-pointer items-center gap-2 rounded-[9px] bg-[#111315] px-5 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-[#30373A]">Se SitePulse Cloud <span class="text-[#F4B400]" aria-hidden="true">↗</span></a></div>
        <div class="rounded-[14px] border border-[#D9DDDA] bg-white shadow-[0_16px_50px_rgba(17,19,21,0.08)]">
          <div class="flex items-center justify-between border-b border-[#E5E8E4] px-5 py-4 sm:px-7"><div><p class="text-sm font-semibold">Når byggeplassen trenger det</p><p class="mt-1 text-xs text-[#768287]">Byggvarme · sone nord</p></div><span class="inline-flex items-center gap-2 rounded-full bg-[#E7F2E2] px-3 py-1.5 text-xs font-semibold text-[#467135]"><span class="h-1.5 w-1.5 rounded-full bg-[#7CAA59]"></span>Aktiv regel</span></div>
          <div class="space-y-5 p-5 sm:p-7"><div><p class="zimo-eyebrow">Når</p><div class="mt-3 flex flex-wrap items-center gap-3"><span class="rounded-[8px] border border-[#F4B400]/35 bg-[#FFF9E7] px-4 py-3 text-sm font-semibold text-[#6D5100]">Temperatur i sone nord</span><span class="text-sm text-[#68767A]">er under</span><span class="rounded-[8px] border border-[#D9DDDA] bg-[#FBFCF9] px-4 py-3 text-sm font-semibold">5 °C</span></div></div><div class="border-l-2 border-[#F4B400] pl-5"><p class="zimo-eyebrow">Så</p><div class="mt-3 flex flex-wrap gap-3"><span class="rounded-[8px] border border-[#CFE2C6] bg-[#F0F7EC] px-4 py-3 text-sm font-semibold text-[#467135]">Varsle ansvarlig</span><span class="rounded-[8px] border border-[#CFE2C6] bg-[#F0F7EC] px-4 py-3 text-sm font-semibold text-[#467135]">Start byggvarme</span></div></div><div class="flex items-start gap-3 border-t border-[#E5E8E4] pt-5"><svg class="mt-0.5 h-5 w-5 shrink-0 text-[#7CAA59]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><p class="text-sm leading-relaxed text-[#68767A]">Regelen kjører når nødvendig utstyr er koblet til. Demo-visning.</p></div></div>
        </div>
      </div>
    </section>

    <section class="border-y border-[#D9DDDA] bg-white py-20 lg:py-28">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
        <div class="overflow-hidden rounded-[14px] bg-[#DDE3E2]"><img src="/images/sitepulse-construction-manager.png" alt="Byggeleder som følger byggeplassdata på mobil" class="h-full min-h-[360px] w-full object-cover object-[68%_center]" loading="lazy" decoding="async" /></div>
        <div><p class="zimo-eyebrow">Fra felt til Cloud</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Teknologi som tåler en faktisk byggeplass.</h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-[#566267]">SitePulse er laget for situasjoner der det er støv, skiftende forhold og lite tid til å følge opp alt manuelt. En enkel gateway kobler sensorer og utstyr til en løsning teamet kan bruke i hverdagen.</p><div class="mt-8 grid gap-5 border-t border-[#E5E8E4] pt-6 sm:grid-cols-2"><div><p class="text-sm font-semibold">Fysisk kontroll</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Temperatur, fukt og utstyr der arbeidet skjer.</p></div><div><p class="text-sm font-semibold">Digital oversikt</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Status, historikk og handling i nettleseren.</p></div></div></div>
      </div>
    </section>

    <section id="pris" class="bg-[#F4B400] py-20 text-[#111315] lg:py-24">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div><p class="zimo-eyebrow text-[#6D5100]">En modell som følger prosjektet</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Betal for kontrollen. Eier utstyret dere bruker.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#5C4811]">Start med ett prosjekt og et konkret behov. Legg til noder når dere trenger dem, og flytt utstyret videre når prosjektet er ferdig.</p></div>
        <div class="grid gap-px overflow-hidden rounded-[12px] border border-[#B9890D] bg-[#B9890D] sm:grid-cols-3">
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Gateway</p><p class="mt-4 text-xl font-semibold">Fra 399 kr/mnd</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Én plattform per byggeplass.</p></div>
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Noder</p><p class="mt-4 text-xl font-semibold">Eies av dere</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Kjøp bare det prosjektet trenger.</p></div>
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Lager</p><p class="mt-4 text-xl font-semibold">Ved behov</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Bruk utstyret mer enn ett sted.</p></div>
        </div>
      </div>
    </section>

    <section id="kontakt" class="bg-[#111315] py-20 text-white lg:py-28">
