---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const useCases = [
  { label: "Byggvarme", text: "Unngå at varme står på lenger enn nødvendig." },
  { label: "Støp og herding", text: "Følg forholdene når kvalitet og fremdrift teller." },
  { label: "Uttørking", text: "Se når inneklimaet faktisk utvikler seg riktig vei." },
  { label: "Frost og lekkasje", text: "Få et varsel før et lite avvik blir et stort problem." },
];

const steps = [
  { number: "1", title: "Start med ett behov", text: "Velg den kontrollen som koster mest tid, energi eller usikkerhet i dag." },
  { number: "2", title: "Bestill når dere trenger", text: "Legg til noder og utstyr fra SitePulse Cloud når en ny sone eller oppgave oppstår." },
  { number: "3", title: "Bruk mer av det dere har", text: "Behold noder dere eier, flytt dem mellom prosjekter og bygg videre i samme løsning." },
];
---

<BaseLayout title="SitePulse - lavere kostnader på byggeplassen" description="SitePulse gir entreprenører en rimelig skyløsning for oversikt, varsler, bestilling og mindre svinn av energi og utstyr på byggeplassen.">
  <Header />
  <main id="main-content" class="bg-[#f5f6f7] text-[#20272a]">
    <section class="relative isolate flex min-h-[650px] items-end overflow-hidden bg-[#171a1b] text-white sm:min-h-[600px]">
      <img src="/images/sitepulse-construction-manager.png" alt="Byggeleder som følger byggeplassdata på mobil" class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]" loading="eager" decoding="async" />
      <div class="absolute inset-0 -z-10 bg-black/58" aria-hidden="true"></div>
      <div class="zimo-shell w-full pb-12 pt-32 sm:pb-14 sm:pt-28 lg:pb-16">
        <div class="max-w-2xl">
          <p class="zimo-eyebrow text-white/68">SitePulse for byggeplassen</p>
          <h1 class="mt-5 max-w-3xl text-5xl font-semibold leading-[1.04] sm:text-6xl lg:text-7xl">Lavere kostnader.<br />Mindre som blir stående ubrukt.</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/82 sm:text-xl">SitePulse gir dere oversikt, varsler og styring i én enkel skyløsning. Dere sparer både energi, tid og utstyr - uten å kjøpe mer enn prosjektet trenger.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="#kostnad" class="inline-flex cursor-pointer items-center justify-center rounded-md bg-[#f5bd28] px-6 py-3.5 text-sm font-semibold text-[#1d2426] transition-colors hover:bg-[#ffca3d]">Se kostnadsmodellen</a><a href="#kontakt" class="inline-flex cursor-pointer items-center justify-center rounded-md border border-white/45 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">Snakk om en pilot</a></div>
          <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-white/80"><span><span class="mr-2 inline-block h-2 w-2 rounded-full bg-[#f5bd28]"></span>Fra 399 kr/mnd</span><span><span class="mr-2 inline-block h-2 w-2 rounded-full bg-[#f5bd28]"></span>Noder eies av dere</span><span><span class="mr-2 inline-block h-2 w-2 rounded-full bg-[#f5bd28]"></span>Bestill ved behov</span></div>
        </div>
      </div>
    </section>

    <section id="kostnad" class="border-b border-[#d9dde0] bg-[#f5bd28] py-16 text-[#20272a] lg:py-20">
      <div class="zimo-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end"><div><p class="zimo-eyebrow text-[#5d4914]">En modell som holder kostnadene nede</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.08] md:text-5xl">Betal for plattformen. Eier utstyret dere faktisk bruker.</h2></div><div class="grid gap-0 border-y border-[#b78510] sm:grid-cols-3 sm:border-x">{[{title:"Gateway",value:"Fra 399 kr/mnd",text:"Et enkelt abonnement per byggeplass."},{title:"Noder",value:"Eies av dere",text:"Kjøp bare de nodene prosjektet trenger."},{title:"Lager",value:"Ved behov",text:"Vi holder vanlige noder klare til neste behov."}].map((item) => <div class="border-b border-[#b78510] p-6 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0"><p class="text-sm font-medium text-[#5d4914]">{item.title}</p><p class="mt-4 text-xl font-semibold">{item.value}</p><p class="mt-3 text-sm leading-relaxed text-[#5d4914]">{item.text}</p></div>)}</div></div>
    </section>

    <section id="plattform" class="border-b border-[#dbe0e2] bg-white py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-end"><div><p class="zimo-eyebrow">SitePulse Cloud</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.08] text-[#20272a] md:text-5xl">Alt som trenger oppmerksomhet, på ett skjermbilde.</h2></div><div class="max-w-xl lg:justify-self-end"><p class="text-lg leading-relaxed text-[#5d686d]">SitePulse Cloud er laget for den raske sjekken før møtet, mellom rundene og når noe haster. Her følger dere status, ser hva som brukes og bestiller når prosjektet trenger mer.</p><a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-md bg-[#20272a] px-5 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-[#374145]">Åpne SitePulse Cloud<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></a></div></div>
        <div class="mt-14 overflow-hidden border border-[#d7dddf] bg-[#eef1f2] p-3 shadow-[0_18px_60px_rgba(32,39,42,0.10)] sm:p-5">
          <div class="overflow-hidden border border-[#d7dddf] bg-white">
            <div class="flex h-14 items-center justify-between border-b border-[#e6eaeb] px-4 sm:px-6"><div class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full bg-[#f5bd28]"></span><span class="text-sm font-semibold text-[#263033]">SitePulse Cloud</span><span class="hidden text-sm text-[#819094] sm:inline">/ Bryggeparken</span></div><span class="rounded-full bg-[#edf7ee] px-3 py-1 text-xs font-medium text-[#397146]">Alt i orden</span></div>
            <div class="grid min-h-[430px] lg:grid-cols-[12rem_1fr]">
              <aside class="hidden border-r border-[#e6eaeb] bg-[#fafbfb] p-4 lg:block"><p class="px-3 text-xs font-medium uppercase tracking-[0.08em] text-[#8a9699]">Prosjekt</p><nav class="mt-4 grid gap-1 text-sm"><a class="rounded-md bg-[#e7edef] px-3 py-2.5 font-medium text-[#263033]" href="#plattform">Oversikt</a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Varsler <span class="float-right rounded-full bg-[#fff0ed] px-2 py-0.5 text-xs text-[#b14a3b]">1</span></a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Utstyr</a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Bestill noder</a></nav></aside>
              <div class="p-5 sm:p-7"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-sm text-[#778488]">Tirsdag 10:42</p><h3 class="mt-1 text-2xl font-semibold text-[#20272a]">God morgen, Mads</h3></div><button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[#d7dddf] text-[#526064]" aria-label="Åpne varsler"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg></button></div>
                <div class="mt-7 grid gap-3 sm:grid-cols-3"><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Sone nord</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">18,2°</p><p class="mt-2 text-xs font-medium text-[#397146]">Innenfor grense</p></div><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Byggvarme</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">På</p><p class="mt-2 text-xs font-medium text-[#397146]">Styrt av regel</p></div><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Aktive noder</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">6</p><p class="mt-2 text-xs font-medium text-[#677579]">Av 8 dere eier</p></div></div>
                <div class="mt-5 border border-[#dce2e3] p-5"><div class="flex items-center justify-between gap-4"><div><p class="font-semibold text-[#20272a]">Temperatur siste døgn</p><p class="mt-1 text-sm text-[#788488]">Sone nord</p></div><span class="text-sm font-medium text-[#397146]">Stabil</span></div><svg class="mt-6 h-28 w-full" viewBox="0 0 620 110" preserveAspectRatio="none" role="img" aria-label="Stabil temperaturkurve"><path d="M0 90H620M0 55H620M0 20H620" stroke="#e8edee" stroke-width="1" /><path d="M0 72C35 67 40 52 80 57S128 75 168 61S217 39 255 48S293 70 331 58S379 30 415 42S464 65 501 54S556 42 620 45" fill="none" stroke="#7b9d3d" stroke-width="3" vector-effect="non-scaling-stroke" /></svg></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="bruksomrader" class="border-b border-[#dbe0e2] py-20 lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start"><div><p class="zimo-eyebrow">Start med det viktigste</p><h2 class="mt-5 max-w-md text-4xl font-semibold leading-[1.08] md:text-5xl">Én løsning. Mange ting den kan gjøre enklere.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#5d686d]">Dere trenger ikke kjøpe hele visjonen på dag én. Start med et konkret spørsmål og bygg videre når dere ser nytten.</p></div><div class="border-t border-[#cfd7d9]">{useCases.map((item, index) => <article class="grid gap-3 border-b border-[#cfd7d9] py-7 sm:grid-cols-[3rem_1fr_1.25fr] sm:gap-5"><span class="text-sm font-medium text-[#7b9d3d]">0{index + 1}</span><h3 class="text-xl font-semibold">{item.label}</h3><p class="text-base leading-relaxed text-[#607074]">{item.text}</p></article>)}</div></div></section>

    <section id="automasjon" class="bg-[#20272a] py-20 text-white lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-center"><div><p class="zimo-eyebrow text-[#c3d893]">Enkel automasjon</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.08] md:text-5xl">La systemet ta den enkle oppfølgingen.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-white/70">Når dere er klare, kan SitePulse følge enkle regler. Det er lett å se hva som skjer, og en avtalt handling kan alltid overstyres manuelt.</p></div><div class="overflow-hidden border border-white/14 bg-[#f7f9f8] text-[#20272a] shadow-[0_18px_60px_rgba(0,0,0,0.22)]"><div class="flex items-center justify-between border-b border-[#dbe0e2] px-5 py-4 sm:px-7"><div><p class="text-sm font-semibold">Ny regel</p><p class="mt-0.5 text-xs text-[#778488]">Byggvarme - Sone nord</p></div><span class="rounded-full bg-[#edf7ee] px-3 py-1 text-xs font-medium text-[#397146]">Aktiv</span></div><div class="space-y-4 p-5 sm:p-7"><p class="text-sm font-medium text-[#69777b]">Når</p><div class="flex flex-wrap items-center gap-3"><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Temperatur i Sone nord</span><span class="text-[#69777b]">er under</span><span class="rounded-md border border-[#dce2e3] bg-white px-4 py-3 text-sm font-medium">5 °C</span></div><div class="border-l border-[#d1d9db] pb-2 pl-5 pt-4"><p class="text-sm font-medium text-[#69777b]">Så</p><div class="mt-3 flex flex-wrap items-center gap-3"><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Varsle ansvarlig</span><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Start byggvarme</span></div></div><div class="mt-2 flex items-center gap-3 border-t border-[#e1e6e7] pt-5"><span class="h-2.5 w-2.5 rounded-full bg-[#8eb24d]"></span><p class="text-sm text-[#657276]">Regelen kjører når nødvendig utstyr er koblet til.</p></div></div></div></div></section>

    <section id="gateway" class="border-b border-[#dbe0e2] bg-white py-20 lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"><div><p class="zimo-eyebrow">Lett å komme i gang</p><h2 class="mt-5 max-w-2xl text-4xl font-semibold leading-[1.08] md:text-5xl">Én gateway på byggeplassen. Full kontroll i SitePulse Cloud.</h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-[#5d686d]">Gatewayen kobler sensorer og utstyr til SitePulse Cloud. Etter oppsettet følger dere prosjektet i nettleseren - på kontoret eller i felt. Legg til noder fra lageret når dere faktisk trenger dem, og flytt eget utstyr til neste prosjekt når jobben er ferdig.</p></div><div class="grid gap-px border border-[#d9e0e1] bg-[#d9e0e1] sm:grid-cols-2"><div class="bg-[#f5f7f7] p-7"><p class="text-sm font-semibold">På byggeplassen</p><p class="mt-3 text-sm leading-relaxed text-[#657276]">Gateway, noder og utstyr dere ønsker å følge - tilpasset dette prosjektet.</p></div><div class="bg-[#f5f7f7] p-7"><p class="text-sm font-semibold">I SitePulse Cloud</p><p class="mt-3 text-sm leading-relaxed text-[#657276]">Status, varsler, historikk, bestilling og enkle regler - tilgjengelig for teamet.</p></div></div></div></section>

    <section id="pilot" class="py-20 lg:py-28"><div class="zimo-shell"><div class="grid gap-12 border-y border-[#cfd7d9] py-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start"><div><p class="zimo-eyebrow">Mindre svinn, mer nytte</p><h2 class="mt-5 max-w-md text-4xl font-semibold leading-[1.08] md:text-5xl">Kjøp færre noder. Bruk dem mer.</h2><p class="mt-5 max-w-md text-lg leading-relaxed text-[#5d686d]">Når noder kan bestilles ved behov, eies av dere og flyttes videre mellom prosjekter, ligger det mindre utstyr ubrukt i skur og lager.</p></div><ol class="grid gap-7 md:grid-cols-3">{steps.map((step) => <li><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#f5bd28] text-sm font-semibold text-[#20272a]">{step.number}</span><h3 class="mt-5 text-xl font-semibold">{step.title}</h3><p class="mt-3 text-sm leading-relaxed text-[#607074]">{step.text}</p></li>)}</ol></div></div></section>

    <section id="rammer" class="border-y border-[#dbe0e2] bg-[#e9edee] py-16"><div class="zimo-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr]"><div><p class="zimo-eyebrow">Tydelige rammer</p><h2 class="mt-4 text-2xl font-semibold">Praktisk byggeplassoppfølging, utviklet uavhengig.</h2></div><div class="max-w-3xl text-base leading-relaxed text-[#59666b]"><p>SitePulse utvikles som et selvstendig ZiMO-prosjekt med egne ressurser og offentlig tilgjengelig teknologi. Plattformen handler om generell byggeplassovervåkning, varsling og enkel automasjon. Konfidensiell kunnskap, internt materiale og arbeidsgiverspesifikke løsninger brukes ikke.</p></div></div></section>

    <section id="kontakt" class="bg-[#f5bd28] py-20 text-[#20272a] lg:py-28"><div class="zimo-shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end"><div><p class="zimo-eyebrow text-[#5d4914]">SitePulse pilot</p><h2 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.08] md:text-5xl">Hvilken kostnad på byggeplassen vil dere få bedre kontroll på først?</h2></div><div class="lg:justify-self-end"><p class="max-w-md text-lg leading-relaxed text-[#594816]">Fortell oss om energi, byggvarme, fukt, lekkasje eller et annet konkret behov. Vi setter opp en enkel pilot med noder og funksjoner som passer prosjektet.</p><a href="mailto:mads.falk@zimo.no" class="mt-7 inline-flex cursor-pointer items-center justify-center rounded-md bg-[#20272a] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#374145]">Snakk om SitePulse</a></div></div></section>
  </main>
  <Footer />
</BaseLayout>
