---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const benefits = [
  { title: "Se hva som skjer", text: "Få en rolig oversikt over temperatur, fukt, energi og utstyr - samlet per prosjekt og sone." },
  { title: "Fang opp avvik tidlig", text: "Velg grensene selv. SitePulse gir beskjed når noe trenger oppmerksomhet." },
  { title: "Bruk historikken", text: "Se utvikling over tid, dokumenter forholdene og ta bedre valg i neste prosjekt." },
];

const useCases = [
  { label: "Byggvarme", text: "Unngå at varme står på lenger enn nødvendig." },
  { label: "Støp og herding", text: "Følg forholdene når kvalitet og fremdrift teller." },
  { label: "Uttørking", text: "Se når inneklimaet faktisk utvikler seg riktig vei." },
  { label: "Frost og lekkasje", text: "Få et varsel før et lite avvik blir et stort problem." },
];

const steps = [
  { number: "1", title: "Velg ett behov", text: "Start med det som er mest tidkrevende eller kostbart å følge opp manuelt." },
  { number: "2", title: "Følg med", text: "Se status, få varsler og del samme prosjektbilde med de som trenger det." },
  { number: "3", title: "Gjør mer", text: "Koble til flere soner eller legg til en enkel automasjon når det gir verdi." },
];
---

<BaseLayout title="SitePulse - enklere oversikt på byggeplassen" description="SitePulse gir entreprenører en enkel skyløsning for oversikt, varsler og praktisk automasjon på byggeplassen.">
  <Header />
  <main id="main-content" class="bg-[#f5f6f7] text-[#20272a]">
    <section class="relative isolate flex min-h-[650px] items-end overflow-hidden bg-[#171a1b] text-white sm:min-h-[600px]">
      <img src="/images/sitepulse-construction-manager.png" alt="Byggeleder som følger byggeplassdata på mobil" class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]" loading="eager" decoding="async" />
      <div class="absolute inset-0 -z-10 bg-black/58" aria-hidden="true"></div>
      <div class="zimo-shell w-full pb-16 pt-36 sm:pb-20 lg:pb-24">
        <div class="max-w-2xl">
          <p class="zimo-eyebrow text-white/68">SitePulse for byggeplassen</p>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.04] sm:text-6xl lg:text-7xl">Full oversikt.<br />Mindre oppfølging.</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/82 sm:text-xl">SitePulse samler det som skjer på byggeplassen i en enkel skyløsning. Se status, få varsler og bruk mindre tid på manuelle kontroller.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="#plattform" class="inline-flex cursor-pointer items-center justify-center rounded-md bg-[#d9f05a] px-6 py-3.5 text-sm font-semibold text-[#1d2426] transition-colors hover:bg-[#e6f67f]">Se hvordan det virker</a><a href="#kontakt" class="inline-flex cursor-pointer items-center justify-center rounded-md border border-white/45 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">Snakk om en pilot</a></div>
        </div>
      </div>
    </section>

    <section id="plattform" class="border-b border-[#dbe0e2] bg-white py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-end"><div><p class="zimo-eyebrow">Ett sted å følge opp</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.08] text-[#20272a] md:text-5xl">Alt som trenger oppmerksomhet, på ett skjermbilde.</h2></div><p class="max-w-xl text-lg leading-relaxed text-[#5d686d] lg:justify-self-end">Du trenger ikke en ny teknisk arbeidsflate. SitePulse er laget for den raske sjekken før møtet, mellom rundene og når noe haster.</p></div>
        <div class="mt-14 overflow-hidden border border-[#d7dddf] bg-[#eef1f2] p-3 shadow-[0_18px_60px_rgba(32,39,42,0.10)] sm:p-5">
          <div class="overflow-hidden border border-[#d7dddf] bg-white">
            <div class="flex h-14 items-center justify-between border-b border-[#e6eaeb] px-4 sm:px-6"><div class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full bg-[#d9f05a]"></span><span class="text-sm font-semibold text-[#263033]">SitePulse</span><span class="hidden text-sm text-[#819094] sm:inline">/ Bryggeparken</span></div><span class="rounded-full bg-[#edf7ee] px-3 py-1 text-xs font-medium text-[#397146]">Alt i orden</span></div>
            <div class="grid min-h-[430px] lg:grid-cols-[12rem_1fr]">
              <aside class="hidden border-r border-[#e6eaeb] bg-[#fafbfb] p-4 lg:block"><p class="px-3 text-xs font-medium uppercase tracking-[0.08em] text-[#8a9699]">Prosjekt</p><nav class="mt-4 grid gap-1 text-sm"><a class="rounded-md bg-[#e7edef] px-3 py-2.5 font-medium text-[#263033]" href="#plattform">Oversikt</a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Varsler <span class="float-right rounded-full bg-[#fff0ed] px-2 py-0.5 text-xs text-[#b14a3b]">1</span></a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Soner</a><a class="rounded-md px-3 py-2.5 text-[#657276]" href="#plattform">Historikk</a></nav></aside>
              <div class="p-5 sm:p-7"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-sm text-[#778488]">Tirsdag 10:42</p><h3 class="mt-1 text-2xl font-semibold text-[#20272a]">God morgen, Mads</h3></div><button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[#d7dddf] text-[#526064]" aria-label="Åpne varsler"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg></button></div>
                <div class="mt-7 grid gap-3 sm:grid-cols-3"><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Sone nord</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">18,2°</p><p class="mt-2 text-xs font-medium text-[#397146]">Innenfor grense</p></div><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Byggvarme</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">På</p><p class="mt-2 text-xs font-medium text-[#397146]">Styrt av regel</p></div><div class="border border-[#dce2e3] bg-[#fbfcfc] p-4"><p class="text-sm text-[#748185]">Åpne varsler</p><p class="mt-3 text-3xl font-semibold text-[#20272a]">1</p><p class="mt-2 text-xs font-medium text-[#b14a3b]">Sone vest</p></div></div>
                <div class="mt-5 border border-[#dce2e3] p-5"><div class="flex items-center justify-between gap-4"><div><p class="font-semibold text-[#20272a]">Temperatur siste døgn</p><p class="mt-1 text-sm text-[#788488]">Sone nord</p></div><span class="text-sm font-medium text-[#397146]">Stabil</span></div><svg class="mt-6 h-28 w-full" viewBox="0 0 620 110" preserveAspectRatio="none" role="img" aria-label="Stabil temperaturkurve"><path d="M0 90H620M0 55H620M0 20H620" stroke="#e8edee" stroke-width="1" /><path d="M0 72C35 67 40 52 80 57S128 75 168 61S217 39 255 48S293 70 331 58S379 30 415 42S464 65 501 54S556 42 620 45" fill="none" stroke="#7b9d3d" stroke-width="3" vector-effect="non-scaling-stroke" /></svg></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="bruksomrader" class="border-b border-[#dbe0e2] py-20 lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start"><div><p class="zimo-eyebrow">Start med det viktigste</p><h2 class="mt-5 max-w-md text-4xl font-semibold leading-[1.08] md:text-5xl">Én løsning. Mange ting den kan gjøre enklere.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#5d686d]">Dere trenger ikke kjøpe hele visjonen på dag én. Start med et konkret spørsmål og bygg videre når dere ser nytten.</p></div><div class="border-t border-[#cfd7d9]">{useCases.map((item, index) => <article class="grid gap-3 border-b border-[#cfd7d9] py-7 sm:grid-cols-[3rem_1fr_1.25fr] sm:gap-5"><span class="text-sm font-medium text-[#7b9d3d]">0{index + 1}</span><h3 class="text-xl font-semibold">{item.label}</h3><p class="text-base leading-relaxed text-[#607074]">{item.text}</p></article>)}</div></div></section>

    <section id="automasjon" class="bg-[#20272a] py-20 text-white lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-center"><div><p class="zimo-eyebrow text-[#c3d893]">Enkel automasjon</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.08] md:text-5xl">La systemet ta den enkle oppfølgingen.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-white/70">Når dere er klare, kan SitePulse følge enkle regler. Det er lett å se hva som skjer, og en avtalt handling kan alltid overstyres manuelt.</p></div><div class="overflow-hidden border border-white/14 bg-[#f7f9f8] text-[#20272a] shadow-[0_18px_60px_rgba(0,0,0,0.22)]"><div class="flex items-center justify-between border-b border-[#dbe0e2] px-5 py-4 sm:px-7"><div><p class="text-sm font-semibold">Ny regel</p><p class="mt-0.5 text-xs text-[#778488]">Byggvarme - Sone nord</p></div><span class="rounded-full bg-[#edf7ee] px-3 py-1 text-xs font-medium text-[#397146]">Aktiv</span></div><div class="space-y-4 p-5 sm:p-7"><p class="text-sm font-medium text-[#69777b]">Når</p><div class="flex flex-wrap items-center gap-3"><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Temperatur i Sone nord</span><span class="text-[#69777b]">er under</span><span class="rounded-md border border-[#dce2e3] bg-white px-4 py-3 text-sm font-medium">5 °C</span></div><div class="border-l border-[#d1d9db] pb-2 pl-5 pt-4"><p class="text-sm font-medium text-[#69777b]">Så</p><div class="mt-3 flex flex-wrap items-center gap-3"><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Varsle ansvarlig</span><span class="rounded-md border border-[#d8e1d0] bg-[#f1f7e9] px-4 py-3 text-sm font-medium">Start byggvarme</span></div></div><div class="mt-2 flex items-center gap-3 border-t border-[#e1e6e7] pt-5"><span class="h-2.5 w-2.5 rounded-full bg-[#8eb24d]"></span><p class="text-sm text-[#657276]">Regelen kjører når nødvendig utstyr er koblet til.</p></div></div></div></div></section>

    <section id="gateway" class="border-b border-[#dbe0e2] bg-white py-20 lg:py-28"><div class="zimo-shell grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"><div><p class="zimo-eyebrow">Lett å komme i gang</p><h2 class="mt-5 max-w-2xl text-4xl font-semibold leading-[1.08] md:text-5xl">En liten gateway på byggeplassen. Resten skjer i skyen.</h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-[#5d686d]">Gatewayen kobler sensorer og utstyr til SitePulse-kontoen. Etter oppsettet følger dere prosjektet i nettleseren - på kontoret eller i felt. Løsningen kan etter hvert støtte både SitePulse-sensorer og kompatible sensorer.</p></div><div class="grid gap-px border border-[#d9e0e1] bg-[#d9e0e1] sm:grid-cols-2"><div class="bg-[#f5f7f7] p-7"><p class="text-sm font-semibold">På byggeplassen</p><p class="mt-3 text-sm leading-relaxed text-[#657276]">Gateway, sensorer og eventuelt utstyr dere ønsker å følge.</p></div><div class="bg-[#f5f7f7] p-7"><p class="text-sm font-semibold">I SitePulse</p><p class="mt-3 text-sm leading-relaxed text-[#657276]">Status, varsler, historikk og enkle regler - tilgjengelig for teamet.</p></div></div></div></section>

    <section id="pilot" class="py-20 lg:py-28"><div class="zimo-shell"><div class="grid gap-12 border-y border-[#cfd7d9] py-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start"><div><p class="zimo-eyebrow">Fra pilot til plattform</p><h2 class="mt-5 max-w-md text-4xl font-semibold leading-[1.08] md:text-5xl">Begynn i det små. Behold verdien når dere vokser.</h2></div><ol class="grid gap-7 md:grid-cols-3">{steps.map((step) => <li><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#d9f05a] text-sm font-semibold text-[#20272a]">{step.number}</span><h3 class="mt-5 text-xl font-semibold">{step.title}</h3><p class="mt-3 text-sm leading-relaxed text-[#607074]">{step.text}</p></li>)}</ol></div></div></section>

    <section id="rammer" class="border-y border-[#dbe0e2] bg-[#e9edee] py-16"><div class="zimo-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr]"><div><p class="zimo-eyebrow">Tydelige rammer</p><h2 class="mt-4 text-2xl font-semibold">Praktisk byggeplassoppfølging, utviklet uavhengig.</h2></div><div class="max-w-3xl text-base leading-relaxed text-[#59666b]"><p>SitePulse utvikles som et selvstendig ZiMO-prosjekt med egne ressurser og offentlig tilgjengelig teknologi. Plattformen handler om generell byggeplassovervåkning, varsling og enkel automasjon. Konfidensiell kunnskap, internt materiale og arbeidsgiverspesifikke løsninger brukes ikke.</p></div></div></section>

    <section id="kontakt" class="bg-[#d9f05a] py-20 text-[#20272a] lg:py-28"><div class="zimo-shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end"><div><p class="zimo-eyebrow text-[#526330]">SitePulse pilot</p><h2 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.08] md:text-5xl">Hvilken kontroll på byggeplassen skulle dere helst sluppet å gjøre manuelt?</h2></div><div class="lg:justify-self-end"><p class="max-w-md text-lg leading-relaxed text-[#38421f]">Fortell oss om temperatur, fukt, energi, lekkasje eller et annet konkret behov. Vi starter gjerne med en enkel pilot.</p><a href="mailto:mads.falk@zimo.no" class="mt-7 inline-flex cursor-pointer items-center justify-center rounded-md bg-[#20272a] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#374145]">Snakk om SitePulse</a></div></div></section>
  </main>
  <Footer />
</BaseLayout>
