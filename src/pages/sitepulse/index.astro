---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const fieldNodes = [
  { name: "Temperatur", value: "18,2 °C", meta: "Sone nord", icon: "temperature" },
  { name: "Luftfuktighet", value: "41 %", meta: "Sone øst", icon: "humidity" },
];

const flowSteps = [
  { number: "01", title: "Mål i felt", text: "Sensorene følger temperatur, fukt og andre kritiske forhold der arbeidet skjer." },
  { number: "02", title: "Koble lokalt", text: "Enhetene sender data via Zigbee til SitePulse Gateway på byggeplassen." },
  { number: "03", title: "Handle i skyen", text: "Gatewayen sender data til Cloud, der regler varsler, dokumenterer eller styrer utstyr." },
];

const logEntries = [
  { time: "07:20", title: "Byggvarme startet", detail: "Temperatur under 5 °C · sone nord", tone: "yellow" },
  { time: "08:45", title: "Temperatur tilbake i normalområde", detail: "Målt 10,4 °C · automatisk logget", tone: "green" },
  { time: "09:00", title: "Døgnrapport oppdatert", detail: "24 timer med målinger tilgjengelig", tone: "blue" },
];

const costDrivers = [
  { label: "Byggvarme som står på uten behov", response: "Styr etter faktisk temperatur" },
  { label: "Manuelle kontrollrunder", response: "Følg status fra Cloud" },
  { label: "Avvik som oppdages for sent", response: "Varsle når grensen passeres" },
  { label: "Dokumentasjon som må samles i etterkant", response: "Logg målinger og hendelser automatisk" },
];
---

<BaseLayout title="SitePulse – kontroll og lavere kostnader på byggeplassen" description="SitePulse kobler sensorer, gateway og cloud for automatisk overvåkning, dokumentasjon og styring på byggeplassen.">
  <Header />

  <main id="main-content">
    <section class="relative overflow-hidden bg-[#111315] text-white">
      <div class="zimo-shell flex min-h-[680px] items-center justify-center py-24 text-center lg:min-h-[720px] lg:py-28">
        <div class="relative z-10 max-w-5xl">
          <div class="flex items-center justify-center gap-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/46">
            <span class="h-px w-8 bg-[#F4B400]"></span>
            <span>SitePulse · kontrollsystem for byggeplassen</span>
            <span class="h-px w-8 bg-[#F4B400]"></span>
          </div>
          <h1 class="mx-auto mt-8 max-w-5xl text-[3.4rem] font-semibold leading-[0.96] tracking-[-0.06em] sm:text-7xl lg:text-[5.5rem]">Byggeplassen,<br />under kontroll.</h1>
          <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-white/62 sm:text-xl">SitePulse samler målinger, dokumentasjon og styring i én løsning. Dere ser hva som skjer — og kan reagere når det trengs.</p>
          <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="#plattform" class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-[8px] bg-[#F4B400] px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:bg-[#FFD05A]">Se hvordan SitePulse virker</a>
            <a href="#kontakt" class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-[8px] border border-white/24 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white/55 hover:bg-white/8">Snakk med oss</a>
          </div>
        </div>
      </div>
      <div class="border-t border-white/12">
        <div class="zimo-shell grid grid-cols-2 lg:grid-cols-4">
          <div class="border-b border-r border-white/10 py-5 pr-4 lg:border-b-0"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/34">Målinger</p><p class="mt-2 text-sm font-medium text-white/76">Kontinuerlig</p></div>
          <div class="border-b border-white/10 py-5 pl-4 lg:border-b-0 lg:border-r lg:pr-4"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/34">Dokumentasjon</p><p class="mt-2 text-sm font-medium text-white/76">Automatisk</p></div>
          <div class="border-r border-white/10 py-5 pr-4 lg:pl-4"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/34">Styring</p><p class="mt-2 text-sm font-medium text-white/76">Etter behov</p></div>
          <div class="py-5 pl-4"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-white/34">Forbindelse</p><p class="mt-2 flex items-center gap-2 text-sm font-medium text-white/76"><span class="h-1.5 w-1.5 bg-[#8BAA4A]"></span>LTE</p></div>
        </div>
      </div>
    </section>

    <section id="plattform" class="scroll-mt-20 border-b border-[#D4D8D5] bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="zimo-eyebrow">Slik fungerer SitePulse</p>
            <h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-5xl lg:text-6xl">Fra felt til Cloud.</h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-[#566267] lg:justify-self-end">Enhetene sender målinger til SitePulse Gateway. Gatewayen bruker LTE for å holde SitePulse Cloud oppdatert — uten at prosjektteamet må følge opp forbindelsen.</p>
        </div>

        <div class="mt-16 border-y border-[#C9CFCC] py-12 lg:py-16">
          <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_5rem_0.7fr_7rem_1.15fr] lg:gap-6">
            <div class="border border-[#C9CFCC] bg-white">
              <div class="border-b border-[#D9DDDA] px-5 py-4">
                <p class="text-[10px] font-semibold uppercase tracking-[0.13em] text-[#68767A]">Måleenheter</p>
              </div>
              <div class="divide-y divide-[#D9DDDA]">
                <div class="flex items-center gap-4 px-5 py-5">
                  <div class="flex h-11 w-11 items-center justify-center border border-[#BFC6C3]">
                    <svg class="h-5 w-5 text-[#111315]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 14.76V5a4 4 0 0 0-8 0v9.76a6 6 0 1 0 8 0Z" /><path d="M10 6v10" /></svg>
                  </div>
                  <div><p class="text-sm font-semibold">Temperatur</p><p class="mt-1 text-xs text-[#768287]">Måles kontinuerlig</p></div>
                </div>
                <div class="flex items-center gap-4 px-5 py-5">
                  <div class="flex h-11 w-11 items-center justify-center border border-[#BFC6C3]">
                    <svg class="h-5 w-5 text-[#111315]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3S6 9.2 6 14a6 6 0 0 0 12 0c0-4.8-6-11-6-11Z" /><path d="M9 15.5a3.2 3.2 0 0 0 3 1.8" /></svg>
                  </div>
                  <div><p class="text-sm font-semibold">Luftfuktighet</p><p class="mt-1 text-xs text-[#768287]">Historikk og varsling</p></div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-center">
              <div class="h-12 w-px bg-[#C9CFCC] lg:h-px lg:w-full"></div>
            </div>

            <div class="mx-auto w-full max-w-[220px]">
              <p class="mb-3 text-center text-[10px] font-semibold uppercase tracking-[0.13em] text-[#68767A]">SitePulse Gateway</p>
              <div class="border border-[#30373A] bg-[#171A1C] p-4">
                <div class="relative aspect-[0.9] border border-[#B9BFBC] bg-[#E9EAE7]">
                  <div class="absolute inset-x-0 top-0 flex items-center justify-between border-b border-[#C5CAC7] px-3 py-3"><span class="text-[9px] font-bold uppercase tracking-[0.16em] text-[#30373A]">SitePulse</span><span class="h-2 w-2 bg-[#8BAA4A]"></span></div>
                  <div class="absolute inset-x-5 top-1/2 -translate-y-1/2"><p class="text-[9px] uppercase tracking-[0.12em] text-[#68767A]">Status</p><p class="mt-1 text-sm font-semibold text-[#111315]">Online</p></div>
                  <div class="absolute inset-x-0 bottom-0 border-t border-[#C5CAC7] px-3 py-3 text-[9px] uppercase tracking-[0.12em] text-[#68767A]">Gateway</div>
                </div>
              </div>
            </div>

            <div class="flex flex-col items-center gap-3">
              <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#8B6500]">LTE</p>
              <div class="relative h-12 w-px bg-[#F4B400] lg:h-px lg:w-full"><span class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 bg-[#F4B400]"></span></div>
            </div>

            <div class="border border-[#30373A] bg-[#1B1F23] text-white">
              <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
                <div><p class="text-xs font-semibold">SitePulse Cloud</p><p class="mt-1 text-[10px] uppercase tracking-[0.11em] text-white/38">Prosjektoversikt</p></div>
                <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-white/50"><span class="h-1.5 w-1.5 bg-[#8BAA4A]"></span>Online</div>
              </div>
              <div class="p-5">
                <div class="flex items-end justify-between gap-4"><div><p class="text-[10px] uppercase tracking-[0.11em] text-white/38">Temperatur</p><p class="mt-2 text-2xl font-semibold">18,2 °C</p></div><p class="text-xs text-[#8BAA4A]">Normal drift</p></div>
                <svg class="mt-5 h-28 w-full" viewBox="0 0 420 130" preserveAspectRatio="none" role="img" aria-label="Temperaturtrend i SitePulse Cloud">
                  <path d="M0 100H420M0 60H420M0 20H420" stroke="#343B3F" stroke-width="1" />
                  <path d="M0 91C32 86 45 65 78 75S126 106 159 80S208 42 240 57S282 98 315 72S362 40 420 31" fill="none" stroke="#F4B400" stroke-width="3" vector-effect="non-scaling-stroke" />
                </svg>
                <div class="mt-5 grid grid-cols-2 border-t border-white/10 pt-4 text-xs"><div><p class="text-white/35">Dokumentasjon</p><p class="mt-2 font-semibold">Automatisk</p></div><div class="border-l border-white/10 pl-4"><p class="text-white/35">Styring</p><p class="mt-2 font-semibold text-[#F4B400]">Etter regler</p></div></div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-8 pt-9 md:grid-cols-3">
          <div class="border-t border-[#C9CFCC] pt-5"><span class="text-sm font-semibold text-[#8B6500]">01</span><h3 class="mt-4 text-lg font-semibold">Mål</h3><p class="mt-3 text-sm leading-relaxed text-[#68767A]">Temperatur og luftfuktighet følges der arbeidet skjer.</p></div>
          <div class="border-t border-[#C9CFCC] pt-5"><span class="text-sm font-semibold text-[#8B6500]">02</span><h3 class="mt-4 text-lg font-semibold">Send med LTE</h3><p class="mt-3 text-sm leading-relaxed text-[#68767A]">Gatewayen holder prosjektet koblet til SitePulse Cloud.</p></div>
          <div class="border-t border-[#C9CFCC] pt-5"><span class="text-sm font-semibold text-[#8B6500]">03</span><h3 class="mt-4 text-lg font-semibold">Følg og styr</h3><p class="mt-3 text-sm leading-relaxed text-[#68767A]">Prosjektteamet får historikk, varsler og automatiske regler.</p></div>
        </div>
      </div>
    </section>

    <section id="automasjon" class="scroll-mt-20 bg-[#111315] py-20 text-white lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div class="lg:sticky lg:top-28">
            <p class="zimo-eyebrow text-[#F4B400]">Automatisk styring</p>
            <h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-5xl">Varme bare når det trengs.</h2>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-white/56">SitePulse følger temperaturen og reagerer etter reglene dere setter. Hver måling og handling blir logget.</p>
            <div class="mt-9 border-y border-white/12 py-5 text-sm">
              <div class="grid grid-cols-[5rem_1fr] gap-4"><span class="text-white/38">Når</span><span class="font-semibold">Temperatur under 5 °C</span></div>
              <div class="mt-4 grid grid-cols-[5rem_1fr] gap-4"><span class="text-white/38">Så</span><span class="font-semibold text-[#F4B400]">Start byggvarme</span></div>
              <div class="mt-4 grid grid-cols-[5rem_1fr] gap-4"><span class="text-white/38">Og</span><span class="font-semibold">Logg + varsle ansvarlig</span></div>
            </div>
          </div>

          <div class="border-y border-white/12">
            <div class="flex items-center justify-between gap-5 border-b border-white/12 py-5">
              <div><p class="text-sm font-semibold">Temperatur · sone nord</p><p class="mt-1 text-xs text-white/38">Siste 24 timer · demo-data</p></div>
              <div class="text-right"><p class="text-3xl font-semibold tracking-[-0.04em]">18,2 °C</p><p class="mt-1 text-xs text-[#8BAA4A]">Innenfor grense</p></div>
            </div>
            <div class="py-7">
              <svg class="h-72 w-full" viewBox="0 0 820 300" preserveAspectRatio="none" role="img" aria-label="Temperaturgraf som viser automatisk aktivering av byggvarme">
                <path d="M0 245H820M0 185H820M0 125H820M0 65H820" stroke="#2D3336" stroke-width="1" />
                <path d="M0 218C45 212 65 184 111 193S174 242 220 211S287 144 333 162S397 225 443 190S506 107 554 137S620 209 669 173S743 131 820 107" fill="none" stroke="#F4B400" stroke-width="4" vector-effect="non-scaling-stroke" />
                <path d="M0 227H820" fill="none" stroke="#8D969A" stroke-width="1.5" stroke-dasharray="6 8" vector-effect="non-scaling-stroke" />
                <path d="M504 35V258" fill="none" stroke="#F4B400" stroke-width="1.5" stroke-dasharray="4 7" vector-effect="non-scaling-stroke" />
                <circle cx="554" cy="137" r="5" fill="#F4B400" />
                <circle cx="504" cy="35" r="4" fill="#F4B400" />
                <text x="520" y="31" fill="#F4B400" font-size="12">07:20 · varme startet</text>
              </svg>
              <div class="mt-4 flex justify-between text-[10px] font-medium text-white/35"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>Nå</span></div>
            </div>
            <div class="grid border-t border-white/12 sm:grid-cols-3">
              <div class="border-b border-white/12 py-5 sm:border-b-0 sm:border-r sm:pr-6"><p class="text-[10px] uppercase tracking-[0.11em] text-white/35">Grense</p><p class="mt-2 text-sm font-semibold">5 °C</p></div>
              <div class="border-b border-white/12 py-5 sm:border-b-0 sm:border-r sm:px-6"><p class="text-[10px] uppercase tracking-[0.11em] text-white/35">Sist aktivert</p><p class="mt-2 text-sm font-semibold text-[#F4B400]">07:20</p></div>
              <div class="py-5 sm:pl-6"><p class="text-[10px] uppercase tracking-[0.11em] text-white/35">Manuell overstyring</p><p class="mt-2 text-sm font-semibold">Tilgjengelig</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="dokumentasjon" class="scroll-mt-20 border-b border-[#D4D8D5] bg-white py-20 lg:py-28">
      <div class="zimo-shell grid gap-14 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
        <div class="border-y border-[#C9CFCC]">
          <div class="flex items-center justify-between gap-4 border-b border-[#C9CFCC] py-5">
            <div><p class="text-sm font-semibold">Prosjektlogg</p><p class="mt-1 text-xs text-[#768287]">Automatisk registrerte hendelser · demo</p></div>
            <a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="cursor-pointer text-xs font-semibold text-[#8B6500] transition-colors duration-200 hover:text-[#111315]">Åpne Cloud ↗</a>
          </div>
          <div class="divide-y divide-[#D9DDDA]">
            {logEntries.map((entry) => (
              <div class="grid gap-4 py-6 sm:grid-cols-[4.5rem_1fr_auto] sm:items-start">
                <p class="text-sm font-semibold">{entry.time}</p>
                <div class="grid grid-cols-[0.65rem_1fr] gap-3"><span class:list={["mt-1.5 h-2 w-2", entry.tone === "yellow" ? "bg-[#F4B400]" : entry.tone === "green" ? "bg-[#8BAA4A]" : "bg-[#4E8DB2]"]}></span><div><p class="text-sm font-semibold">{entry.title}</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">{entry.detail}</p></div></div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-[#768287] sm:text-right">Automatisk</p>
              </div>
            ))}
          </div>
          <div class="grid border-t border-[#C9CFCC] sm:grid-cols-3">
            <div class="border-b border-[#D9DDDA] py-5 sm:border-b-0 sm:border-r sm:pr-6"><p class="text-[10px] uppercase tracking-[0.11em] text-[#768287]">Historikk</p><p class="mt-2 text-sm font-semibold">Målinger over tid</p></div>
            <div class="border-b border-[#D9DDDA] py-5 sm:border-b-0 sm:border-r sm:px-6"><p class="text-[10px] uppercase tracking-[0.11em] text-[#768287]">Hendelser</p><p class="mt-2 text-sm font-semibold">Regler og varsler</p></div>
            <div class="py-5 sm:pl-6"><p class="text-[10px] uppercase tracking-[0.11em] text-[#768287]">Eksport</p><p class="mt-2 text-sm font-semibold">Rapportgrunnlag</p></div>
          </div>
        </div>

        <div class="lg:pl-8">
          <p class="zimo-eyebrow">Automatisk dokumentasjon</p>
          <h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-5xl">Dokumentasjonen skriver seg selv.</h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-[#566267]">Målinger, avvik og handlinger havner i samme tidslinje. Når noen spør hva som skjedde, finnes svaret allerede.</p>
          <ul class="mt-9 divide-y divide-[#D9DDDA] border-y border-[#D9DDDA] text-sm">
            <li class="flex gap-3 py-4"><svg class="mt-0.5 h-5 w-5 shrink-0 text-[#8B6500]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span>Kontinuerlig historikk fra alle tilkoblede enheter</span></li>
            <li class="flex gap-3 py-4"><svg class="mt-0.5 h-5 w-5 shrink-0 text-[#8B6500]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span>Regler, varsler og manuelle handlinger i samme logg</span></li>
            <li class="flex gap-3 py-4"><svg class="mt-0.5 h-5 w-5 shrink-0 text-[#8B6500]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span>Bedre grunnlag for rapportering og overlevering</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="resultater" class="scroll-mt-20 bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
          <div>
            <p class="zimo-eyebrow">Kostnadsbildet</p>
            <h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-5xl">Det koster å ikke vite.</h2>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-[#566267]">Unødvendig drift, manuell oppfølging og sene avvik blir synlige når de samme målingene brukes til både beslutning og dokumentasjon.</p>
          </div>
          <div class="border-y border-[#C9CFCC]">
            {costDrivers.map((item, index) => (
              <div class="grid gap-3 border-b border-[#D9DDDA] py-5 last:border-b-0 sm:grid-cols-[2.5rem_1fr_1fr] sm:items-center">
                <span class="text-sm font-semibold text-[#8B6500]">{String(index + 1).padStart(2, "0")}</span>
                <p class="text-sm font-semibold">{item.label}</p>
                <p class="text-sm text-[#68767A] sm:text-right">{item.response}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-16 border border-[#C9CFCC] bg-white">
          <div class="flex flex-col gap-3 border-b border-[#D9DDDA] px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-sm font-semibold">Eksempel på økonomisk oversikt</p><p class="mt-1 text-xs text-[#768287]">Illustrativ demo · ikke dokumentert kundedata</p></div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#8B6500]">SitePulse Cloud</p>
          </div>
          <div class="grid lg:grid-cols-[0.78fr_1.22fr]">
            <div class="grid border-b border-[#D9DDDA] sm:grid-cols-3 lg:grid-cols-1 lg:border-b-0 lg:border-r">
              <div class="border-b border-[#D9DDDA] p-6 sm:border-b-0 sm:border-r lg:border-b lg:border-r-0"><p class="text-[10px] uppercase tracking-[0.11em] text-[#768287]">Estimert spart</p><p class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[#4F722F]">18 420 kr</p><p class="mt-1 text-xs text-[#768287]">denne måneden</p></div>
              <div class="border-b border-[#D9DDDA] p-6 sm:border-b-0 sm:border-r lg:border-b lg:border-r-0"><p class="text-[10px] uppercase tracking-[0.11em] text-[#768287]">Driftstid byggvarme</p><p class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[#4F722F]">−31 %</p><p class="mt-1 text-xs text-[#768287]">mot forrige periode</p></div>
