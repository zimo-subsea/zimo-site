---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const costDrivers = [
  { label: "Unødvendig byggvarme", status: "Reduseres med regler og tidsplaner", tone: "yellow" },
  { label: "Manuell oppfølging", status: "Samles i ett prosjektbilde", tone: "blue" },
  { label: "Avvik som oppdages for sent", status: "Varsles mens det kan håndteres", tone: "red" },
  { label: "Utstyr som står ubrukt", status: "Flyttes videre mellom prosjekter", tone: "green" },
];

const systemSteps = [
  { number: "01", label: "Mål", text: "Sensorer følger temperatur, fukt og andre forhold der arbeidet skjer." },
  { number: "02", label: "Koble", text: "Gatewayen holder byggeplassen i kontakt med SitePulse Cloud." },
  { number: "03", label: "Forstå", text: "Status, historikk og regler samles i ett prosjektbilde." },
  { number: "04", label: "Handle", text: "Varsle, dokumenter eller styr utstyr når det faktisk trengs." },
];

const solutions = [
  { number: "01", label: "Byggvarme", title: "Varme bare når det trengs", text: "Styr etter målt temperatur og avtalte regler, ikke etter en timer som blir stående på.", status: "På ved behov", tone: "yellow" },
  { number: "02", label: "Dokumentasjon", title: "Dokumentasjonen skriver seg selv", text: "Få målinger, hendelser og historikk samlet i en logg som er klar når dere trenger den.", status: "Løpende logg", tone: "blue" },
  { number: "03", label: "Varsling", title: "Varsler før avvik blir kostnad", text: "Oppdag frost, lekkasje, temperatur- og fuktavvik tidlig nok til å gjøre noe med det.", status: "Tidlig signal", tone: "red" },
];
---

<BaseLayout title="SitePulse - lavere kostnader på byggeplassen" description="SitePulse gir entreprenører bedre kontroll på byggeplassen gjennom automatisk overvåkning, dokumentasjon og styring.">
  <Header />

  <main id="main-content">
    <section class="border-b border-white/10 bg-[#111315] text-white">
      <div class="zimo-shell grid min-h-[680px] items-center gap-12 py-16 lg:grid-cols-[0.86fr_1.14fr] lg:py-20">
        <div class="max-w-2xl">
          <p class="zimo-eyebrow text-[#F4B400]">SitePulse · kontroll på byggeplassen</p>
          <h1 class="mt-6 max-w-2xl text-5xl font-semibold leading-[0.99] tracking-[-0.055em] sm:text-6xl lg:text-[5.1rem]">Lavere kostnader på byggeplassen.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/68 sm:text-xl">Overvåk forholdene, dokumenter automatisk og styr utstyr etter faktisk behov. Se hva som skjer før det blir en kostnad.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#resultater" class="inline-flex cursor-pointer items-center justify-center rounded-[8px] bg-[#F4B400] px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:bg-[#ffd05a]">Se kostnadsbildet</a>
            <a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="inline-flex cursor-pointer items-center justify-center rounded-[8px] border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white/60 hover:bg-white/10">Åpne SitePulse Cloud</a>
          </div>
          <div class="mt-11 grid max-w-xl gap-5 border-t border-white/10 pt-5 text-sm text-white/55 sm:grid-cols-3">
            <div><p class="text-white/85">Overvåk</p><p class="mt-1 leading-relaxed">forholdene løpende</p></div>
            <div><p class="text-white/85">Dokumenter</p><p class="mt-1 leading-relaxed">uten ekstra runder</p></div>
            <div><p class="text-white/85">Styr</p><p class="mt-1 leading-relaxed">når det er nødvendig</p></div>
          </div>
        </div>

        <div class="lg:pl-4">
          <figure class="overflow-hidden rounded-[10px] border border-white/15 bg-[#1B1F23]">
            <img src="/images/sitepulse-construction-manager.png" alt="Byggeleder som følger byggeplassdata på mobil" class="aspect-[1.18] w-full object-cover object-[68%_center]" loading="eager" decoding="async" />
            <figcaption class="border-t border-white/10">
              <div class="flex items-center justify-between gap-4 px-5 py-4">
                <div><p class="text-sm font-semibold">SitePulse Cloud</p><p class="mt-1 text-xs text-white/42">Demo · prosjektoversikt</p></div>
                <span class="inline-flex items-center gap-2 text-xs font-medium text-[#B7E596]"><span class="h-1.5 w-1.5 rounded-full bg-[#9ACB70]"></span>Alt i orden</span>
              </div>
              <div class="grid grid-cols-3 border-t border-white/10">
                <div class="border-r border-white/10 px-5 py-4"><p class="text-xs text-white/42">Temperatur</p><p class="mt-2 text-lg font-semibold">18,2 °C</p><p class="mt-1 text-xs text-white/42">Sone nord</p></div>
                <div class="border-r border-white/10 px-5 py-4"><p class="text-xs text-white/42">Byggvarme</p><p class="mt-2 text-lg font-semibold">På</p><p class="mt-1 text-xs text-[#F4B400]">Styrt av regel</p></div>
                <div class="px-5 py-4"><p class="text-xs text-white/42">Aktive noder</p><p class="mt-2 text-lg font-semibold">6</p><p class="mt-1 text-xs text-white/42">Av 8</p></div>
              </div>
            </figcaption>
          </figure>
          <div class="mt-4 flex items-center justify-between gap-4 border-t border-white/10 pt-4 text-xs text-white/45"><span>Feltdata → SitePulse Cloud</span><span>Demo-visning</span></div>
        </div>
      </div>
    </section>

    <section id="resultater" class="border-b border-[#D9DDDA] bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="zimo-eyebrow">Kostnadsbildet</p>
          <h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Det koster å ikke vite.</h2>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-[#566267]">Unødvendig drift, manuell oppfølging og sene avvik blir fort usynlige kostnader. SitePulse gjør dem synlige, slik at dere kan prioritere riktig.</p>
          <a href="#kontakt" class="mt-8 inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:text-[#8B6500]">Snakk om deres prosjekt <span class="text-[#F4B400]" aria-hidden="true">→</span></a>
        </div>
        <div class="border-y border-[#C9CFCC]">
          <div class="flex items-center justify-between gap-4 border-b border-[#C9CFCC] py-4"><div><p class="text-sm font-semibold">Hvor kostnadene oppstår</p><p class="mt-1 text-xs text-[#768287]">Eksempel på SitePulse-oversikt</p></div><span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#8B6500]">Demo</span></div>
          <div class="divide-y divide-[#D9DDDA]">
            {costDrivers.map((item) => <div class="grid gap-3 py-5 sm:grid-cols-[1fr_auto] sm:items-center"><div class="flex items-start gap-3"><span class:list={["mt-1.5 h-2 w-2 shrink-0 rounded-full", item.tone === "yellow" ? "bg-[#F4B400]" : item.tone === "blue" ? "bg-[#4CA6C8]" : item.tone === "red" ? "bg-[#D96B5A]" : "bg-[#7CAA59]"]}></span><p class="text-sm font-semibold">{item.label}</p></div><p class="text-sm text-[#68767A] sm:text-right">{item.status}</p></div>)}
          </div>
          <div class="grid gap-8 border-t border-[#C9CFCC] py-6 sm:grid-cols-[1fr_auto] sm:items-end"><div><p class="zimo-eyebrow">Eksempel på økonomi</p><p class="mt-2 text-4xl font-semibold tracking-[-0.05em]">18 420 kr</p><p class="mt-2 text-sm text-[#68767A]">estimert spart · demo-data</p></div><div class="sm:text-right"><p class="text-2xl font-semibold tracking-[-0.04em] text-[#467135]">−31 %</p><p class="mt-1 text-sm text-[#68767A]">driftstid byggvarme</p></div></div>
        </div>
      </div>
    </section>

    <section id="plattform" class="border-b border-[#D9DDDA] bg-white py-20 lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-end"><div><p class="zimo-eyebrow">Slik henger det sammen</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Fra måling til handling.</h2></div><p class="max-w-xl text-lg leading-relaxed text-[#566267] lg:justify-self-end">SitePulse kobler det fysiske på byggeplassen til en enkel skyløsning. Hvert ledd har en jobb, og hvert signal kan bli til en konkret handling.</p></div>
        <div class="mt-14 grid gap-8 border-y border-[#C9CFCC] py-8 sm:grid-cols-2 lg:grid-cols-4">
          {systemSteps.map((step) => <div class="border-t border-[#D9DDDA] pt-4"><span class="text-sm font-semibold text-[#8B6500]">{step.number}</span><h3 class="mt-5 text-lg font-semibold">{step.label}</h3><p class="mt-3 max-w-[15rem] text-sm leading-relaxed text-[#68767A]">{step.text}</p></div>)}
        </div>
        <div class="mt-14 grid gap-px border border-[#D9DDDA] bg-[#D9DDDA] sm:grid-cols-3">
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">På byggeplassen</p><p class="mt-3 text-sm font-semibold">Sensorer og utstyr</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Målinger der forholdene faktisk oppstår.</p></div>
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">Mellomrommet</p><p class="mt-3 text-sm font-semibold">SitePulse Gateway</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Holder prosjektet koblet til Cloud.</p></div>
          <div class="bg-[#F8F9F6] p-6"><p class="zimo-eyebrow">I Cloud</p><p class="mt-3 text-sm font-semibold">Status og regler</p><p class="mt-2 text-sm leading-relaxed text-[#68767A]">Historikk, varsler og automasjon i samme bilde.</p></div>
        </div>
      </div>
    </section>

    <section id="losninger" class="bg-[#1B1F23] py-20 text-white lg:py-28">
      <div class="zimo-shell">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-end"><div><p class="zimo-eyebrow text-[#F4B400]">Bygd rundt de dyre spørsmålene</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Store problemer. Enklere oppfølging.</h2></div><p class="max-w-xl text-lg leading-relaxed text-white/55 lg:justify-self-end">Start med ett konkret behov. Bygg videre når dere ser hvor mye kontrollen er verdt.</p></div>
        <div class="mt-16 divide-y divide-white/12 border-y border-white/12">
          {solutions.map((solution) => <article class="grid gap-6 py-9 lg:grid-cols-[3.5rem_0.8fr_1fr_auto] lg:items-start"><span class:list={["text-sm font-semibold", solution.tone === "yellow" ? "text-[#F4B400]" : solution.tone === "blue" ? "text-[#69BBDD]" : "text-[#E98A78]"]}>{solution.number}</span><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-white/40">{solution.label}</p><h3 class="mt-3 max-w-md text-2xl font-semibold leading-tight tracking-[-0.025em]">{solution.title}</h3></div><p class="max-w-xl text-base leading-relaxed text-white/55 lg:pt-6">{solution.text}</p><p class="text-sm font-medium text-white/75 lg:pt-6">{solution.status}</p></article>)}
        </div>
      </div>
    </section>

    <section id="automasjon" class="bg-[#F5F5F2] py-20 lg:py-28">
      <div class="zimo-shell grid gap-14 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
        <div><p class="zimo-eyebrow">Automasjon</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Byggeplassen reagerer selv.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#566267]">Regler gjør at dere kan handle på målingene, ikke på magefølelsen. Hver handling er synlig, og kan overstyres manuelt.</p><a href="https://sitepulse.zimo.no" target="_blank" rel="noreferrer" class="mt-8 inline-flex cursor-pointer items-center gap-2 rounded-[8px] bg-[#111315] px-5 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-[#30373A]">Se SitePulse Cloud <span class="text-[#F4B400]" aria-hidden="true">↗</span></a></div>
        <div class="border border-[#C9CFCC] bg-white">
          <div class="flex items-center justify-between gap-4 border-b border-[#D9DDDA] px-5 py-4 sm:px-7"><div><p class="text-sm font-semibold">Når byggeplassen trenger det</p><p class="mt-1 text-xs text-[#768287]">Byggvarme · sone nord</p></div><span class="text-xs font-semibold text-[#467135]">Aktiv regel</span></div>
          <div class="space-y-6 p-5 sm:p-7"><div><p class="zimo-eyebrow">Når</p><div class="mt-3 flex flex-wrap items-center gap-3"><span class="rounded-[7px] border border-[#F4B400]/35 bg-[#FFF9E7] px-4 py-3 text-sm font-semibold text-[#6D5100]">Temperatur i sone nord</span><span class="text-sm text-[#68767A]">er under</span><span class="rounded-[7px] border border-[#D9DDDA] bg-[#FBFCF9] px-4 py-3 text-sm font-semibold">5 °C</span></div></div><div class="border-l-2 border-[#F4B400] pl-5"><p class="zimo-eyebrow">Så</p><div class="mt-3 flex flex-wrap gap-3"><span class="rounded-[7px] border border-[#CFE2C6] bg-[#F0F7EC] px-4 py-3 text-sm font-semibold text-[#467135]">Varsle ansvarlig</span><span class="rounded-[7px] border border-[#CFE2C6] bg-[#F0F7EC] px-4 py-3 text-sm font-semibold text-[#467135]">Start byggvarme</span></div></div><div class="flex items-start gap-3 border-t border-[#E5E8E4] pt-5"><svg class="mt-0.5 h-5 w-5 shrink-0 text-[#7CAA59]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><p class="text-sm leading-relaxed text-[#68767A]">Regelen kjører når nødvendig utstyr er koblet til. Demo-visning.</p></div></div>
        </div>
      </div>
    </section>

    <section id="pris" class="bg-[#F4B400] py-20 text-[#111315] lg:py-24">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div><p class="zimo-eyebrow text-[#6D5100]">En modell som følger prosjektet</p><h2 class="mt-5 max-w-lg text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Betal for kontrollen. Eier utstyret dere bruker.</h2><p class="mt-6 max-w-md text-lg leading-relaxed text-[#5C4811]">Start med ett prosjekt og et konkret behov. Legg til noder når dere trenger dem, og flytt utstyret videre når prosjektet er ferdig.</p></div>
        <div class="grid gap-px border border-[#B9890D] bg-[#B9890D] sm:grid-cols-3">
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Gateway</p><p class="mt-4 text-xl font-semibold">Fra 399 kr/mnd</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Én plattform per byggeplass.</p></div>
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Noder</p><p class="mt-4 text-xl font-semibold">Eies av dere</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Kjøp bare det prosjektet trenger.</p></div>
          <div class="bg-[#F7C12B] p-6"><p class="text-sm font-semibold text-[#6D5100]">Lager</p><p class="mt-4 text-xl font-semibold">Ved behov</p><p class="mt-3 text-sm leading-relaxed text-[#6D5100]">Bruk utstyret mer enn ett sted.</p></div>
        </div>
      </div>
    </section>

    <section id="kontakt" class="bg-[#111315] py-20 text-white lg:py-28">
      <div class="zimo-shell grid gap-12 lg:grid-cols-[1fr_0.72fr] lg:items-end">
        <div><p class="zimo-eyebrow text-[#F4B400]">SitePulse pilot</p><h2 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.045em] md:text-5xl">Hva koster unødvendig drift på deres prosjekt?</h2></div>
        <div class="lg:justify-self-end"><p class="max-w-md text-lg leading-relaxed text-white/58">Fortell oss om energi, byggvarme, fukt, lekkasje eller et annet konkret behov. Vi setter opp en enkel pilot med funksjoner som passer prosjektet.</p><a href="mailto:mads.falk@zimo.no" class="mt-7 inline-flex cursor-pointer items-center justify-center rounded-[8px] bg-[#F4B400] px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:bg-[#ffd05a]">Snakk med oss</a></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
